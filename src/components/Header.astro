---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/(en|da|es|fr|nl|ak|de|nh|yo|ig|kg|sv|pt)/, '');

const enUrl = cleanPath === '' ? '/' : cleanPath;
const daUrl = '/da' + (cleanPath === '/' ? '' : cleanPath);
const esUrl = '/es' + (cleanPath === '/' ? '' : cleanPath);
const frUrl = '/fr' + (cleanPath === '/' ? '' : cleanPath);
const nlUrl = '/nl' + (cleanPath === '/' ? '' : cleanPath);
const akUrl = '/ak' + (cleanPath === '/' ? '' : cleanPath);
const deUrl = '/de' + (cleanPath === '/' ? '' : cleanPath);
const nhUrl = '/nh' + (cleanPath === '/' ? '' : cleanPath);
const yoUrl = '/yo' + (cleanPath === '/' ? '' : cleanPath);
const igUrl = '/ig' + (cleanPath === '/' ? '' : cleanPath);
const kgUrl = '/kg' + (cleanPath === '/' ? '' : cleanPath);
const svUrl = '/sv' + (cleanPath === '/' ? '' : cleanPath);
const ptUrl = '/pt' + (cleanPath === '/' ? '' : cleanPath);

const currentLangName = languages[lang];
---
<header class="site-header">
  <div class="container header-container">
    <a href={translatePath('/')} class="logo" aria-label="Home">Danish West Indies</a>
    <nav class="main-nav" aria-label="Main Navigation">
      <ul>
        <li><a href={translatePath('/history')}>{t('nav.history')}</a></li>
        <li><a href={translatePath('/memorial')}>{t('nav.memorial')}</a></li>
        <li><a href={translatePath('/languages')}>{t('nav.languages')}</a></li>
        <li><a href={translatePath('/resources')}>{t('nav.resources')}</a></li>
        <li><a href={translatePath('/educators')}>Educators</a></li>
        <li><a href={translatePath('/interactive/archivists-dilemma')}>Interactive</a></li>
        <li><a href={translatePath('/thesis')}>{t('nav.thesis')}</a></li>
        <li><a href={translatePath('/faq')}>{t('nav.faq')}</a></li>
        <li><a href={translatePath('/about')}>{t('nav.about')}</a></li>
        <li><a href={translatePath('/contact')}>{t('nav.contact')}</a></li>
      </ul>
      
      <div class="header-actions">
        <button id="btn-search" class="search-btn" aria-label="Search Site">🔍</button>
        
        <div class="lang-dropdown">
          <button class="lang-btn" aria-haspopup="true" aria-expanded="false" aria-label="Select Language">{currentLangName} ▼</button>
          <div class="lang-menu">
            <a href={enUrl} class={lang === 'en' ? 'active' : ''}>English</a>
            <a href={daUrl} class={lang === 'da' ? 'active' : ''}>Dansk</a>
            <a href={esUrl} class={lang === 'es' ? 'active' : ''}>Español</a>
            <a href={frUrl} class={lang === 'fr' ? 'active' : ''}>Français</a>
            <a href={nlUrl} class={lang === 'nl' ? 'active' : ''}>Nederlands</a>
            <a href={deUrl} class={lang === 'de' ? 'active' : ''}>Deutsch</a>
            <a href={svUrl} class={lang === 'sv' ? 'active' : ''}>Svenska</a>
            <a href={ptUrl} class={lang === 'pt' ? 'active' : ''}>Português</a>
            <div class="lang-divider"></div>
            <a href={akUrl} class={lang === 'ak' ? 'active' : ''}>Akan (Twi)</a>
            <a href={yoUrl} class={lang === 'yo' ? 'active' : ''}>Yorùbá</a>
            <a href={igUrl} class={lang === 'ig' ? 'active' : ''}>Igbo</a>
            <a href={kgUrl} class={lang === 'kg' ? 'active' : ''}>Kikongo</a>
            <a href={nhUrl} class={lang === 'nh' ? 'active' : ''}>Negerhollands</a>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<!-- GLOBAL SEARCH MODAL -->
<div id="search-modal" class="search-modal hidden">
  <div class="search-overlay" id="search-overlay"></div>
  <div class="search-container">
    <div class="search-header">
      <input type="text" id="search-input" placeholder="Search history, thesis, and resources..." autocomplete="off">
      <button id="btn-close-search" class="close-btn" aria-label="Close Search">✕</button>
    </div>
    <div id="search-results" class="search-results">
      <div class="search-empty">Type to start searching...</div>
    </div>
  </div>
</div>

<style>
  .site-header {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }
  
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }
  
  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
  }
  
  .main-nav a {
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-decoration: none;
  }
  
  .main-nav a:hover {
    color: var(--color-accent);
  }

  /* Actions Area */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Dropdown Styles */
  .lang-dropdown {
    position: relative;
    display: inline-block;
  }

  .lang-btn, .search-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(196,167,125,0.2);
    color: var(--color-text);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
  }
  .search-btn { padding: 0.4rem 0.8rem; border-radius: 50%; }

  .lang-dropdown:hover .lang-btn, .search-btn:hover {
    background: rgba(196,167,125,0.1);
    border-color: var(--color-accent);
  }

  .lang-menu {
    display: none;
    position: absolute;
    right: 0;
    top: 100%;
    margin-top: 0.5rem;
    background: #1a1613; /* Match theme background */
    border: 1px solid rgba(196,167,125,0.3);
    border-radius: 8px;
    padding: 0.5rem;
    min-width: 160px;
    z-index: 100;
    box-shadow: 0 10px 25px rgba(0,0,0,0.8);
  }

  .lang-dropdown:hover .lang-menu {
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.2s ease;
  }

  .lang-menu a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    transition: all 0.2s;
    font-size: 0.85rem;
    text-transform: none; /* Override main-nav */
    letter-spacing: normal;
  }

  .lang-menu a:hover {
    background: rgba(196,167,125,0.1);
    color: #fff;
  }

  .lang-menu a.active {
    color: var(--color-accent);
    background: rgba(196,167,125,0.05);
    font-weight: 600;
  }

  .lang-divider {
    height: 1px;
    background: rgba(196,167,125,0.2);
    margin: 0.5rem 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Search Modal Styles */
  .search-modal {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 9999; display: flex; justify-content: center; align-items: flex-start;
    padding-top: 10vh;
  }
  .search-modal.hidden { display: none !important; }
  .search-overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.8); backdrop-filter: blur(5px);
  }
  .search-container {
    position: relative; width: 90%; max-width: 700px;
    background: #1a1613; border: 1px solid rgba(196,167,125,0.3);
    border-radius: 12px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    display: flex; flex-direction: column; max-height: 80vh;
  }
  .search-header {
    display: flex; align-items: center; padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(196,167,125,0.1); background: rgba(0,0,0,0.2);
  }
  #search-input {
    flex-grow: 1; background: transparent; border: none; color: white;
    font-size: 1.2rem; outline: none; padding: 0.5rem; font-family: var(--font-body);
  }
  #search-input::placeholder { color: rgba(255,255,255,0.3); }
  .close-btn {
    background: none; border: none; color: rgba(255,255,255,0.5); font-size: 1.5rem;
    cursor: pointer; padding: 0.5rem; transition: color 0.2s;
  }
  .close-btn:hover { color: var(--color-accent); }
  
  .search-results {
    padding: 1.5rem; overflow-y: auto; flex-grow: 1; display: flex; flex-direction: column; gap: 1rem;
  }
  .search-empty { text-align: center; color: rgba(255,255,255,0.3); padding: 2rem; font-style: italic; }
  .search-item {
    display: block; text-decoration: none; padding: 1rem; border-radius: 8px;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); transition: all 0.2s;
  }
  .search-item:hover { background: rgba(255,255,255,0.08); border-color: rgba(196,167,125,0.3); }
  .search-item h4 { margin: 0 0 0.4rem 0; color: var(--color-accent); font-size: 1.1rem; }
  .search-item p { margin: 0; color: rgba(255,255,255,0.7); font-size: 0.9rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .search-badge { display: inline-block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; padding: 0.2rem 0.6rem; background: rgba(196,167,125,0.2); color: var(--color-accent); border-radius: 4px; margin-bottom: 0.5rem; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnSearch = document.getElementById('btn-search');
    const modal = document.getElementById('search-modal');
    const overlay = document.getElementById('search-overlay');
    const btnClose = document.getElementById('btn-close-search');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');

    let searchData = null;

    function openSearch() {
      modal.classList.remove('hidden');
      input.focus();
      
      // Fetch index on first open
      if (!searchData) {
        fetch('/api/search.json')
          .then(res => res.json())
          .then(data => { searchData = data; })
          .catch(err => console.error("Search index failed to load", err));
      }
    }

    function closeSearch() {
      modal.classList.add('hidden');
      input.value = '';
      resultsContainer.innerHTML = '<div class="search-empty">Type to start searching...</div>';
    }

    btnSearch?.addEventListener('click', openSearch);
    btnClose?.addEventListener('click', closeSearch);
    overlay?.addEventListener('click', closeSearch);
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeSearch();
    });

    input?.addEventListener('input', (e) => {
      if (!searchData) return;
      
      const query = e.target.value.toLowerCase().trim();
      if (query.length < 2) {
        resultsContainer.innerHTML = '<div class="search-empty">Type at least 2 characters...</div>';
        return;
      }

      const results = searchData.filter(item => 
        (item.title && item.title.toLowerCase().includes(query)) || 
        (item.description && item.description.toLowerCase().includes(query)) ||
        (item.tags && item.tags.some(tag => tag.toLowerCase().includes(query)))
      ).slice(0, 15); // limit to 15 results

      if (results.length === 0) {
        resultsContainer.innerHTML = '<div class="search-empty">No results found.</div>';
        return;
      }

      resultsContainer.innerHTML = results.map(item => `
        <a href="${item.url}" class="search-item">
          <span class="search-badge">${item.type}</span>
          <h4>${item.title}</h4>
          <p>${item.description}</p>
        </a>
      `).join('');
    });
  });
</script>

