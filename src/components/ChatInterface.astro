---
// src/components/ChatInterface.astro
interface Props {
  isWidget?: boolean;
}

const { isWidget = false } = Astro.props;
---

<div class={`chat-container ${isWidget ? 'is-widget' : 'is-page'}`} id={isWidget ? 'chat-widget-container' : 'chat-page-container'}>
  <div class="chat-header">
    <span class="chat-icon">📚</span>
    <div class="chat-title-group">
      <h3>Chat with the Archive</h3>
      <span class="chat-subtitle">Powered by Claude 3.5</span>
    </div>
    {isWidget && <button id="close-chat-widget" class="close-btn" aria-label="Close Chat">✕</button>}
  </div>
  
  <div class="chat-messages" id={`chat-messages-${isWidget ? 'widget' : 'page'}`}>
    <div class="message assistant">
      <div class="message-content">
        <p>Hello! I am an AI assistant trained on the Danish West Indies archive. You can ask me questions like "Why did the 1878 Fireburn happen?" or "Who was Peter von Scholten?"</p>
      </div>
    </div>
  </div>

  <form class="chat-form" id={`chat-form-${isWidget ? 'widget' : 'page'}`}>
    <div id={`chat-suggestions-${isWidget ? 'widget' : 'page'}`} class="chat-suggestions"></div>
    <div class="chat-input-group">
      <input type="text" class="chat-input" id={`chat-input-${isWidget ? 'widget' : 'page'}`} placeholder="Ask a question..." autocomplete="off" required />
      <button type="button" class="mic-btn" id={`chat-mic-${isWidget ? 'widget' : 'page'}`} title="Hold to speak">🎤</button>
      <button type="submit" class="chat-submit-btn">Send</button>
    </div>
  </form>
</div>

<style>
  .chat-container {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  /* Widget specific styles */
  .chat-container.is-widget {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 350px;
    height: 500px;
    z-index: 9998;
    transform: translateY(120%);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .chat-container.is-widget.open {
    transform: translateY(0);
  }

  /* Page specific styles */
  .chat-container.is-page {
    width: 100%;
    max-width: 800px;
    height: 70vh;
    margin: 0 auto;
  }

  .chat-header {
    background: rgba(196,167,125,0.1);
    padding: 1rem;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }

  .chat-icon {
    font-size: 1.5rem;
    margin-right: 0.8rem;
  }

  .chat-title-group {
    flex-grow: 1;
  }

  .chat-title-group h3 {
    margin: 0;
    font-family: var(--font-heading);
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  .chat-subtitle {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.2rem;
    cursor: pointer;
  }

  .chat-messages {
    flex-grow: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .message {
    max-width: 85%;
    display: flex;
  }

  .message.user {
    align-self: flex-end;
  }
  .message.assistant {
    align-self: flex-start;
  }

  .message-content {
    padding: 0.8rem 1rem;
    border-radius: 12px;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .message.user .message-content {
    background: var(--color-accent);
    color: #111;
    border-bottom-right-radius: 4px;
  }

  .message.assistant .message-content {
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-bottom-left-radius: 4px;
  }

  .message-content p { margin: 0 0 0.5rem 0; }
  .message-content p:last-child { margin: 0; }
  
  .message-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .message.user .message-content :global(a) {
    color: #111;
  }

  .chat-form {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border-top: 1px solid var(--color-border);
    background: rgba(0,0,0,0.2);
  }

  .chat-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }
  .chat-suggestion-chip {
    background: rgba(196,167,125,0.1);
    border: 1px solid rgba(196,167,125,0.3);
    color: var(--color-accent);
    padding: 0.4rem 0.8rem;
    border-radius: 16px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .chat-suggestion-chip:hover {
    background: rgba(196,167,125,0.2);
    transform: translateY(-1px);
  }

  .chat-input-group {
    display: flex;
    gap: 0.5rem;
  }

  .chat-input {
    flex-grow: 1;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 0.6rem 1rem;
    color: white;
    font-family: var(--font-body);
    outline: none;
  }
  .chat-input:focus {
    border-color: var(--color-accent);
  }

  .mic-btn {
    background: transparent;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    transition: transform 0.2s;
    padding: 0 0.5rem;
  }
  .mic-btn.recording {
    color: #ef4444;
    animation: pulse 1s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  .chat-submit-btn {
    background: transparent;
    border: none;
    color: var(--color-accent);
    font-weight: bold;
    padding: 0 1rem;
    cursor: pointer;
  }
  .chat-submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

	.typing-indicator {
		font-style: italic;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		padding: 0.5rem 1rem;
	}

	.tts-btn {
		background: none;
		border: none;
		color: var(--color-text-muted);
		cursor: pointer;
		padding: 0 0.5rem;
		font-size: 1.1rem;
		transition: color 0.2s;
		display: flex;
		align-items: center;
	}
	.tts-btn:hover, .tts-btn.playing {
		color: var(--color-accent);
	}

	:global(.glossary-term) {
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-style: dotted;
		cursor: help;
		position: relative;
	}
	:global(.glossary-term .tooltip) {
		visibility: hidden;
		background: #111;
		color: #fff;
		text-align: left;
		padding: 0.5rem;
		border-radius: 4px;
		position: absolute;
		z-index: 10000;
		bottom: 125%;
		left: 50%;
		transform: translateX(-50%);
		width: max-content;
		max-width: 200px;
		font-size: 0.8rem;
		border: 1px solid var(--color-accent);
		box-shadow: 0 4px 10px rgba(0,0,0,0.5);
		font-family: var(--font-body);
		font-weight: normal;
		line-height: 1.4;
	}
	:global(.glossary-term:hover .tooltip) {
		visibility: visible;
	}
</style>

<script>
	const glossaryTerms = [
		{ term: "Fireburn", def: "The massive 1878 labor riot on St. Croix where workers demanded better wages and working conditions." },
		{ term: "Marronage", def: "The act of enslaved people escaping and forming independent settlements (Maroons)." },
		{ term: "Rix-dollar", def: "The official currency used in the Danish West Indies (Rigsdaler)." },
		{ term: "Chattel Slavery", def: "A form of slavery where humans are treated as personal property to be bought, sold, and inherited." },
		{ term: "Middle Passage", def: "The horrific transatlantic journey of enslaved Africans from the West African coast to the Americas." }
	];

  // A simple markdown to html converter for streaming text
  function parseMarkdown(text: string) {
		let html = text
			.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
			.replace(/\*(.*?)\*/g, '<em>$1</em>')
			.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
			.replace(/\n\n/g, '</p><p>')
			.replace(/\n- (.*)/g, '<li>$1</li>');
		
		html = html.replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>');
		
		// Apply Glossary
		glossaryTerms.forEach(item => {
			const regex = new RegExp(`\\b(${item.term})\\b`, 'gi');
			// Replace only if not already inside a tag
			html = html.replace(regex, `<span class="glossary-term">$1<span class="tooltip">${item.def}</span></span>`);
		});

		if (!html.startsWith('<p>')) html = '<p>' + html;
		if (!html.endsWith('</p>')) html = html + '</p>';
		return html;
	}

  function setupChat(isWidget: boolean) {
    const idSuffix = isWidget ? 'widget' : 'page';
    const form = document.getElementById(`chat-form-${idSuffix}`);
    const input = document.getElementById(`chat-input-${idSuffix}`) as HTMLInputElement;
    const messagesContainer = document.getElementById(`chat-messages-${idSuffix}`);
    const submitBtn = form?.querySelector('.chat-submit-btn') as HTMLButtonElement;
    const suggestionsContainer = document.getElementById(`chat-suggestions-${idSuffix}`);

    // To keep conversation context
    let messages = [];

    async function sendMessage(text: string) {
      if (!text) return;

      // Clear suggestions
      if (suggestionsContainer) suggestionsContainer.innerHTML = '';

      // Add user message to UI
      const userMsg = document.createElement('div');
      userMsg.className = 'message user';
      userMsg.innerHTML = `<div class="message-content"><p>${text}</p></div>`;
      messagesContainer?.appendChild(userMsg);
      
      // Update context array
      messages.push({ role: 'user', content: text });

      input.value = '';
      input.disabled = true;
      submitBtn.disabled = true;
      messagesContainer.scrollTop = messagesContainer.scrollHeight;

      // Create empty assistant message for streaming
      const assistantMsg = document.createElement('div');
      assistantMsg.className = 'message assistant';
      
      const assistantContentWrapper = document.createElement('div');
      assistantContentWrapper.style.display = 'flex';
      assistantContentWrapper.style.alignItems = 'flex-start';
      
      const assistantContent = document.createElement('div');
      assistantContent.className = 'message-content';
      assistantContent.innerHTML = '<span class="typing-indicator">Retrieving from archives...</span>';
      
      // TTS Button
      const ttsBtn = document.createElement('button');
      ttsBtn.className = 'tts-btn hidden';
      ttsBtn.innerHTML = '🔊';
      ttsBtn.title = 'Read aloud';
      
      assistantContentWrapper.appendChild(assistantContent);
      assistantContentWrapper.appendChild(ttsBtn);
      assistantMsg.appendChild(assistantContentWrapper);
      
      messagesContainer?.appendChild(assistantMsg);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages })
        });

        if (!response.ok) throw new Error('API Error');

        const reader = response.body?.getReader();
        const decoder = new TextDecoder();
        let fullResponse = '';

        if (reader) {
          assistantContent.innerHTML = '';
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            
            const chunk = decoder.decode(value, { stream: true });
            
            const lines = chunk.split('\n');
            for (const line of lines) {
              if (line.startsWith('0:')) {
                try {
                  const textContent = JSON.parse(line.substring(2));
                  fullResponse += textContent;
                } catch(e) {
                  fullResponse += line.substring(2).replace(/"/g, ''); 
                }
              }
            }
            
            // Extract suggestions if they exist
            let displayResponse = fullResponse;
            const suggestionsMatch = fullResponse.match(/<suggestions>([\s\S]*?)<\/suggestions>/);
            
            if (suggestionsMatch && suggestionsContainer) {
              displayResponse = fullResponse.replace(/<suggestions>[\s\S]*?<\/suggestions>/, '').trim();
              
              // Only parse and render suggestions if streaming is nearly complete to avoid jitter
              const rawSuggestions = suggestionsMatch[1].trim().split('\n').filter(s => s.trim());
              suggestionsContainer.innerHTML = '';
              rawSuggestions.forEach(sug => {
                const btn = document.createElement('button');
                btn.className = 'chat-suggestion-chip';
                btn.type = 'button';
                btn.textContent = sug;
                btn.addEventListener('click', () => sendMessage(sug));
                suggestionsContainer.appendChild(btn);
              });
            }

            assistantContent.innerHTML = parseMarkdown(displayResponse);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
          }
        }
        
        const finalContent = fullResponse.replace(/<suggestions>[\s\S]*?<\/suggestions>/, '').trim();
        messages.push({ role: 'assistant', content: finalContent });

        // Setup TTS
        if ('speechSynthesis' in window && finalContent) {
          ttsBtn.classList.remove('hidden');
          let utterance: SpeechSynthesisUtterance | null = null;
          
          ttsBtn.addEventListener('click', () => {
            if (speechSynthesis.speaking) {
              speechSynthesis.cancel();
              ttsBtn.classList.remove('playing');
              return;
            }
            
            // Remove asterisks and raw URLs for speech
            const cleanText = finalContent.replace(/\*/g, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
            utterance = new SpeechSynthesisUtterance(cleanText);
            // Basic language detection attempt for TTS
            if(cleanText.includes(' la ') || cleanText.includes(' el ')) utterance.lang = 'es-ES';
            else if(cleanText.includes(' og ') || cleanText.includes(' det ')) utterance.lang = 'da-DK';
            else utterance.lang = 'en-US';
            
            utterance.onstart = () => ttsBtn.classList.add('playing');
            utterance.onend = () => ttsBtn.classList.remove('playing');
            speechSynthesis.speak(utterance);
          });
        }

      } catch (err) {
        assistantContent.innerHTML = '<p class="error">Sorry, I encountered an error communicating with the archive. Please try again later.</p>';
      } finally {
        input.disabled = false;
        submitBtn.disabled = false;
        input.focus();
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      sendMessage(input.value.trim());
    });

    // Speech-to-Text setup
    const micBtn = document.getElementById(`chat-mic-${idSuffix}`);
    if (micBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
      const SpeechRecognition = window.webkitSpeechRecognition || (window as any).SpeechRecognition;
      const recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = true;

      recognition.onstart = () => {
        micBtn.classList.add('recording');
        input.placeholder = "Listening...";
      };

      recognition.onresult = (event: any) => {
        const transcript = Array.from(event.results)
          .map((result: any) => result[0].transcript)
          .join('');
        input.value = transcript;
      };

      recognition.onend = () => {
        micBtn.classList.remove('recording');
        input.placeholder = "Ask a question...";
        if (input.value.trim().length > 0) {
          sendMessage(input.value.trim());
        }
      };

      recognition.onerror = () => {
        micBtn.classList.remove('recording');
        input.placeholder = "Ask a question...";
      };

      micBtn.addEventListener('mousedown', () => recognition.start());
      micBtn.addEventListener('mouseup', () => recognition.stop());
      micBtn.addEventListener('touchstart', (e) => { e.preventDefault(); recognition.start(); });
      micBtn.addEventListener('touchend', (e) => { e.preventDefault(); recognition.stop(); });
    } else if (micBtn) {
      micBtn.style.display = 'none'; // hide if not supported
    }
  }

  // Setup both instances if they exist
  document.addEventListener('DOMContentLoaded', () => {
    if (document.getElementById('chat-form-page')) setupChat(false);
    if (document.getElementById('chat-form-widget')) setupChat(true);
  });
</script>
