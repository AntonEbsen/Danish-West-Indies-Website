---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="History - Danish West Indies">
	<div class="page-header animate-fade-in">
		<h1>Historical Context</h1>
		<p class="subtitle">Exploring the timeline, events, and lives affected in the Danish West Indies.</p>
	</div>
	
	<section class="content-section animate-fade-in" style="animation-delay: 0.2s;">
		<p>Content collections for history articles will be displayed here.</p>
	</section>
</Layout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-lg);
	}
	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-muted);
	}
</style>
