---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const journeys = await getCollection('journeys');
---

<Layout title="Educational Journeys | Danish West Indies">
	<div class="page-header animate-fade-in">
		<a href="/memorial" class="back-link">← Back to Memorial Register</a>
		<h1>Educational Journeys</h1>
		<p class="subtitle">Curated narratives that guide you through the history of the enslaved in the Danish West Indies.</p>
	</div>

	<section class="journeys-grid animate-fade-in" style="animation-delay: 0.2s;">
		{journeys.map(journey => (
			<a href={`/journeys/${journey.id}`} class="journey-card">
				<div class="journey-icon">📖</div>
				<h2>{journey.data.title}</h2>
				<p>{journey.data.description}</p>
				{journey.data.featuredProfiles && (
					<span class="journey-profiles">{journey.data.featuredProfiles.length} featured individuals</span>
				)}
				<span class="journey-cta">Begin Journey →</span>
			</a>
		))}

		{journeys.length === 0 && (
			<p class="empty-state">Journeys are currently being prepared. Check back soon.</p>
		)}
	</section>
</Layout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: var(--space-sm);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-xl);
	}

	.page-header h1 {
		font-size: clamp(2rem, 5vw, 4rem);
		color: var(--color-text);
		margin-bottom: var(--space-xs);
	}

	.subtitle {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		font-style: italic;
		font-family: var(--font-heading);
		max-width: 600px;
		margin: 0 auto;
	}

	.journeys-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: var(--space-lg);
		max-width: 900px;
		margin: 0 auto;
	}

	.journey-card {
		display: flex;
		flex-direction: column;
		background: var(--color-bg-light);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: var(--space-lg);
		text-decoration: none;
		color: inherit;
		transition: all var(--transition-fast);
	}

	.journey-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
		border-color: var(--color-accent);
	}

	.journey-icon {
		font-size: 2rem;
		margin-bottom: var(--space-sm);
	}

	.journey-card h2 {
		font-size: 1.4rem;
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}

	.journey-card p {
		font-size: 0.95rem;
		color: var(--color-text-muted);
		line-height: 1.6;
		flex: 1;
		margin-bottom: var(--space-md);
	}

	.journey-profiles {
		display: inline-block;
		font-size: 0.8rem;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.25rem 0.6rem;
		border-radius: 4px;
		margin-bottom: var(--space-sm);
		width: fit-content;
	}

	.journey-cta {
		font-size: 0.9rem;
		color: var(--color-accent);
		font-weight: 600;
	}

	.empty-state {
		text-align: center;
		color: var(--color-text-muted);
		font-style: italic;
		grid-column: 1 / -1;
		padding: var(--space-lg) 0;
	}
</style>
