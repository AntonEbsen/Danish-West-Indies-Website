---
import Layout from '../layouts/Layout.astro';
import AmbientSound from '../components/AmbientSound.astro';
---

<Layout title="Contribute to the Register | Danish West Indies">
	<div class="contribute-page">
		<div class="page-header animate-fade-in">
			<h1>Help Us Remember</h1>
			<p class="subtitle">Contribute an ancestor's name, story, or documentation to the Memorial Register.</p>
		</div>

		<div class="form-container animate-fade-in" style="animation-delay: 0.2s;">
			<!-- Progress Bar -->
			<div class="progress-bar">
				<div class="step active" id="step-indicator-1">1. Your Info</div>
				<div class="step" id="step-indicator-2">2. Ancestor Details</div>
				<div class="step" id="step-indicator-3">3. Documentation</div>
			</div>

			<!-- Multi-step Form -->
			<form id="contribution-form" action="/success" method="POST" enctype="multipart/form-data">
				
				<!-- Step 1: Your Info -->
				<div class="form-step active" id="step-1">
					<h2>Step 1: Your Information</h2>
					<div class="form-group">
						<label for="submitter-name">Your Full Name</label>
						<input type="text" id="submitter-name" name="submitter-name" required />
					</div>
					<div class="form-group">
						<label for="submitter-email">Email Address</label>
						<input type="email" id="submitter-email" name="submitter-email" required />
					</div>
					<div class="form-group">
						<label for="relationship">Relationship to Ancestor (if any)</label>
						<input type="text" id="relationship" name="relationship" placeholder="e.g. Great-Great Grandchild, Researcher" />
					</div>
					<div class="form-actions">
						<button type="button" class="btn-primary btn-next" data-next="2">Next Step →</button>
					</div>
				</div>

				<!-- Step 2: Ancestor Details -->
				<div class="form-step" id="step-2">
					<h2>Step 2: Ancestor Details</h2>
					<div class="form-group">
						<label for="ancestor-name">Ancestor's Name</label>
						<input type="text" id="ancestor-name" name="ancestor-name" required />
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="birth-year">Estimated Birth Year</label>
							<input type="number" id="birth-year" name="birth-year" min="1600" max="1917" />
						</div>
						<div class="form-group">
							<label for="death-year">Estimated Death Year</label>
							<input type="number" id="death-year" name="death-year" min="1600" max="1950" />
						</div>
					</div>
					<div class="form-group">
						<label for="location">Known Location / Plantation</label>
						<input type="text" id="location" name="location" placeholder="e.g. La Grange, St. Croix" />
					</div>
					<div class="form-group">
						<label for="biography">Biography or Oral History</label>
						<textarea id="biography" name="biography" rows="5" placeholder="Share their story or any details passed down through generations..."></textarea>
					</div>
					<div class="form-actions space-between">
						<button type="button" class="btn-secondary btn-prev" data-prev="1">← Previous</button>
						<button type="button" class="btn-primary btn-next" data-next="3">Next Step →</button>
					</div>
				</div>

				<!-- Step 3: Documentation -->
				<div class="form-step" id="step-3">
					<h2>Step 3: Documentation & Sources</h2>
					<p class="step-desc">Upload any census records, church books, or photographs if you have them.</p>
					
					<div class="form-group file-upload">
						<label for="documents" class="file-label">
							<span class="file-icon">📁</span>
							<span class="file-text">Click to upload files (PDF, JPG, PNG)</span>
						</label>
						<input type="file" id="documents" name="documents" multiple accept=".pdf,.jpg,.jpeg,.png" />
					</div>
					
					<div class="form-group">
						<label for="sources">Text Sources or Links</label>
						<textarea id="sources" name="sources" rows="3" placeholder="e.g. 1841 St. Croix Census, Rigsarkivet..."></textarea>
					</div>
					
					<div class="form-actions space-between">
						<button type="button" class="btn-secondary btn-prev" data-prev="2">← Previous</button>
						<button type="submit" class="btn-primary btn-submit">Submit to Archive</button>
					</div>
				</div>

				<!-- Success Message (hidden by default) -->
				<div class="form-success" id="form-success">
					<div class="success-icon">✨</div>
					<h2>Thank You</h2>
					<p>Your contribution has been submitted to our archival team for review. You are helping to ensure their name is never forgotten.</p>
					<a href="/memorial" class="btn-primary">Return to Register</a>
				</div>
			</form>
		</div>
	</div>
	<AmbientSound />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('contribution-form') as HTMLFormElement;
		const nextBtns = document.querySelectorAll('.btn-next');
		const prevBtns = document.querySelectorAll('.btn-prev');
		const steps = document.querySelectorAll('.form-step');
		const indicators = document.querySelectorAll('.step');
		const successMessage = document.getElementById('form-success');

		// Handle Next Button
		nextBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const currentStepNum = parseInt(btn.getAttribute('data-next')!) - 1;
				const currentStep = document.getElementById(`step-${currentStepNum}`);
				
				// Basic validation before moving next
				const requiredInputs = currentStep?.querySelectorAll('[required]');
				let isValid = true;
				requiredInputs?.forEach((input: any) => {
					if (!input.value) {
						isValid = false;
						input.classList.add('error');
					} else {
						input.classList.remove('error');
					}
				});

				if (isValid) {
					const nextStepNum = btn.getAttribute('data-next');
					showStep(nextStepNum);
				}
			});
		});

		// Handle Previous Button
		prevBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const prevStepNum = btn.getAttribute('data-prev');
				showStep(prevStepNum);
			});
		});

		function showStep(stepNum: string | null) {
			steps.forEach(step => step.classList.remove('active'));
			indicators.forEach(ind => ind.classList.remove('active'));
			
			document.getElementById(`step-${stepNum}`)?.classList.add('active');
			
			// Highlight indicators up to current step
			for (let i = 1; i <= parseInt(stepNum!); i++) {
				document.getElementById(`step-indicator-${i}`)?.classList.add('active');
			}
		}

		// Handle Mock Submission
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			steps.forEach(step => step.classList.remove('active'));
			document.querySelector('.progress-bar')!.setAttribute('style', 'display: none;');
			successMessage!.style.display = 'block';
		});

		// Remove error class on input
		form.querySelectorAll('input, textarea').forEach(input => {
			input.addEventListener('input', () => {
				input.classList.remove('error');
			});
		});
	});
</script>

<style>
	.contribute-page {
		max-width: 800px;
		margin: 0 auto;
		padding: var(--space-xl) 0;
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-xl);
	}

	.page-header h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		color: var(--color-text);
		margin-bottom: var(--space-xs);
	}

	.subtitle {
		font-size: 1.2rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	.form-container {
		background: var(--color-bg-light);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: var(--space-xl);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}

	/* Progress Bar */
	.progress-bar {
		display: flex;
		justify-content: space-between;
		margin-bottom: var(--space-xl);
		position: relative;
	}

	.progress-bar::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--color-border);
		z-index: 0;
		transform: translateY(-50%);
	}

	.step {
		background: var(--color-bg);
		border: 2px solid var(--color-border);
		color: var(--color-text-muted);
		padding: 0.5rem 1rem;
		border-radius: 20px;
		font-size: 0.9rem;
		position: relative;
		z-index: 1;
		transition: all var(--transition-fast);
	}

	.step.active {
		border-color: var(--color-accent);
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
	}

	/* Form Steps */
	.form-step {
		display: none;
		animation: fadeIn 0.5s ease;
	}

	.form-step.active {
		display: block;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.form-step h2 {
		font-size: 1.5rem;
		color: var(--color-accent);
		margin-bottom: var(--space-md);
	}

	.step-desc {
		color: var(--color-text-muted);
		margin-bottom: var(--space-lg);
	}

	.form-group {
		margin-bottom: var(--space-lg);
	}

	.form-row {
		display: flex;
		gap: var(--space-lg);
	}
	
	.form-row .form-group {
		flex: 1;
	}

	label {
		display: block;
		margin-bottom: 0.5rem;
		color: var(--color-text);
		font-size: 0.95rem;
	}

	input[type="text"],
	input[type="email"],
	input[type="number"],
	textarea {
		width: 100%;
		padding: 0.8rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 4px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 1rem;
		transition: border-color var(--transition-fast);
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	input.error,
	textarea.error {
		border-color: #ff4a4a;
	}

	/* File Upload Styling */
	.file-upload input[type="file"] {
		display: none;
	}

	.file-label {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: var(--space-xl);
		border: 2px dashed var(--color-border);
		border-radius: 8px;
		cursor: pointer;
		transition: all var(--transition-fast);
	}

	.file-label:hover {
		border-color: var(--color-accent);
		background: rgba(196, 167, 125, 0.05);
	}

	.file-icon {
		font-size: 2rem;
		margin-bottom: 0.5rem;
	}

	/* Buttons */
	.form-actions {
		display: flex;
		justify-content: flex-end;
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}

	.form-actions.space-between {
		justify-content: space-between;
	}

	.btn-primary, .btn-secondary {
		padding: 0.8rem 1.5rem;
		border-radius: 4px;
		font-size: 1rem;
		cursor: pointer;
		font-family: var(--font-body);
		transition: all var(--transition-fast);
		border: none;
	}

	.btn-primary {
		background: var(--color-accent);
		color: #111;
		font-weight: bold;
	}

	.btn-primary:hover {
		background: #d4b88f;
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: transparent;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
	}

	.btn-secondary:hover {
		border-color: var(--color-text);
		color: var(--color-text);
	}

	/* Success Message */
	.form-success {
		display: none;
		text-align: center;
		padding: var(--space-xl) 0;
		animation: fadeIn 0.5s ease;
	}

	.success-icon {
		font-size: 4rem;
		margin-bottom: var(--space-md);
	}

	.form-success h2 {
		font-size: 2rem;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.form-success p {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		margin-bottom: var(--space-xl);
		max-width: 500px;
		margin-left: auto;
		margin-right: auto;
	}
</style>
