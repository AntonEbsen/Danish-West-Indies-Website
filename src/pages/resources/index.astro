---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');

// Sort alphabetically by title
resources.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Resources | Danish West Indies">
	<div class="page-container animate-fade-in">
		<header class="page-header">
			<span class="label">Knowledge Base</span>
			<h1>Historical Resources</h1>
			<p class="subtitle">A curated directory of archives, books, and digital materials for learning more about the Danish West Indies.</p>
		</header>
		
		<section class="special-feature animate-fade-in" style="animation-delay: 0.1s;">
			<h2>Archival & Academic Pioneers</h2>
			<div class="pioneers-grid">
				<a href="/resources/erik-gobel" class="feature-card">
					<div class="feature-content">
						<h3>Tribute to Erik Gøbel</h3>
						<p>Explore the contributions of the archivist whose 36 years of work at Rigsarkivet unlocked the history of the Danish West Indies.</p>
						<span class="read-more">Read Tribute →</span>
					</div>
				</a>
				<a href="/resources/klas-ronnback" class="feature-card">
					<div class="feature-content">
						<h3>Tribute to Klas Rönnbäck</h3>
						<p>Explore the quantitative methodologies of the Swedish economic historian who proved the foundational profitability of the transatlantic slave trade.</p>
						<span class="read-more">Read Tribute →</span>
					</div>
				</a>
				<a href="/resources/niklas-thode-jensen" class="feature-card">
					<div class="feature-content">
						<h3>Tribute to Niklas Thode Jensen</h3>
						<p>Explore the historian's critical research on how colonial medicine and science were used as mechanisms of power and control.</p>
						<span class="read-more">Read Tribute →</span>
					</div>
				</a>
			</div>
		</section>

		<section class="resources-section animate-fade-in" style="animation-delay: 0.2s;">
			<h2>All Resources</h2>
			<div class="resources-grid">
				{resources.map((res) => (
					<a href={res.data.link} target="_blank" rel="noopener noreferrer" class="resource-card">
						<div class="rc-header">
							<span class={`rc-category type-${res.data.category}`}>{res.data.category}</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
						</div>
						<h3>{res.data.title}</h3>
						<p>{res.data.description}</p>
					</a>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-container {
		max-width: 1100px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-2xl);
	}

	.label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.page-header h1 {
		color: var(--color-accent);
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 1.1rem;
		font-style: italic;
		max-width: 600px;
		margin: 0 auto;
	}

	.special-feature {
		margin-bottom: var(--space-2xl);
		padding-bottom: var(--space-xl);
		border-bottom: 1px solid rgba(196, 167, 125, 0.2);
	}

	.special-feature h2, .resources-section h2 {
		color: var(--color-text);
		margin-bottom: var(--space-lg);
		font-size: 1.8rem;
		text-align: center;
	}

	.feature-card {
		display: block;
		background: linear-gradient(135deg, rgba(196, 167, 125, 0.1) 0%, rgba(0, 0, 0, 0) 100%);
		border: 1px solid rgba(196, 167, 125, 0.3);
		border-radius: 12px;
		padding: var(--space-xl);
		text-decoration: none;
		transition: all 0.3s ease;
		height: 100%;
	}

	.feature-card:hover {
		transform: translateY(-4px);
		border-color: var(--color-accent);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
	}

	.pioneers-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--space-lg);
	}

	.feature-content h3 {
		color: var(--color-accent);
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.feature-content p {
		color: rgba(255, 255, 255, 0.8);
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.read-more {
		color: var(--color-accent);
		font-weight: bold;
		font-size: 0.9rem;
	}

	.resources-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--space-lg);
	}

	.resource-card {
		display: flex;
		flex-direction: column;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		padding: var(--space-lg);
		text-decoration: none;
		transition: all 0.3s ease;
		height: 100%;
	}

	.resource-card:hover {
		transform: translateY(-4px);
		border-color: rgba(196, 167, 125, 0.5);
		background: rgba(196, 167, 125, 0.05);
	}

	.rc-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}

	.rc-category {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-weight: bold;
	}

	.type-website { background: rgba(56, 189, 248, 0.1); color: #38bdf8; }
	.type-archive { background: rgba(250, 204, 21, 0.1); color: #facc15; }
	.type-book { background: rgba(167, 139, 250, 0.1); color: #a78bfa; }
	.type-article { background: rgba(74, 222, 128, 0.1); color: #4ade80; }
	.type-video { background: rgba(248, 113, 113, 0.1); color: #f87171; }

	.external-icon {
		color: var(--color-text-muted);
		transition: color 0.3s;
	}

	.resource-card:hover .external-icon {
		color: var(--color-accent);
	}

	.resource-card h3 {
		color: var(--color-text);
		font-size: 1.2rem;
		margin-bottom: 0.8rem;
		line-height: 1.3;
	}

	.resource-card p {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0;
		flex-grow: 1;
	}
</style>
