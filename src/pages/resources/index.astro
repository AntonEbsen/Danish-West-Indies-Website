---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Resources - Danish West Indies">
	<div class="page-header animate-fade-in">
		<h1>Educational Resources</h1>
		<p class="subtitle">A directory of archives, books, and materials for learning more about the Danish West Indies.</p>
	</div>
	
	<section class="content-section animate-fade-in" style="animation-delay: 0.2s;">
		<h2>Archival Pioneers</h2>
		<ul class="resource-list">
			<li>
				<a href="/resources/erik-gobel">Tribute to Erik Gøbel</a>
				<p>Explore the contributions of the archivist whose 36 years of work at Rigsarkivet unlocked the history of the Danish West Indies.</p>
			</li>
		</ul>

		<h2>Books & Articles</h2>
		<ul class="resource-list">
			<li>Resources will be added here.</li>
		</ul>
	</section>
</Layout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-lg);
	}
	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-muted);
	}
</style>
