---
import Layout from '../layouts/Layout.astro';
import ChatInterface from '../components/ChatInterface.astro';
---

<Layout title="Ask the Archive | Danish West Indies">
	<div class="ask-container animate-fade-in">
		<header class="ask-header">
			<h1>Chat with the Archive</h1>
			<p>Have a question about the Danish West Indies? Our AI assistant can search through hundreds of historical articles, primary sources, and thesis chapters to find your answer.</p>
		</header>
		
		<ChatInterface isWidget={false} />
	</div>
</Layout>

<style>
	.ask-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 0;
	}
	.ask-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	.ask-header h1 {
		font-family: var(--font-heading);
		color: var(--color-accent);
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}
	.ask-header p {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		line-height: 1.6;
	}
</style>
