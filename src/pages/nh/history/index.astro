---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const historyArticles = await getCollection('history');
// Sort by date descending
historyArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="History | Danish West Indies">
	<div class="page-container animate-fade-in">
		<header class="page-header">
			<span class="label">Historical Portal</span>
			<h1>Colonial History</h1>
			<p class="subtitle">Exploring the timeline, events, and lives affected in the Danish West Indies.</p>
		</header>
		
		<section class="articles-section animate-fade-in" style="animation-delay: 0.2s;">
			<div class="articles-grid">
				{historyArticles.map((article) => (
					<a href={`/history/${article.id}`} class="article-card">
						<div class="card-content">
							<span class="date">{article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
							<h2>{article.data.title}</h2>
							{article.data.description && <p>{article.data.description}</p>}
							<span class="read-more">Read Article →</span>
						</div>
					</a>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-container {
		max-width: 1000px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-2xl);
		padding-bottom: var(--space-xl);
		border-bottom: 1px dashed rgba(196, 167, 125, 0.2);
	}

	.label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.page-header h1 {
		color: var(--color-accent);
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 1.2rem;
		font-style: italic;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
		gap: var(--space-lg);
	}

	@media (max-width: 768px) {
		.articles-grid {
			grid-template-columns: 1fr;
		}
	}

	.article-card {
		display: flex;
		flex-direction: column;
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.03) 0%, rgba(0, 0, 0, 0) 100%);
		border: 1px solid rgba(196, 167, 125, 0.2);
		border-radius: 12px;
		padding: var(--space-xl);
		text-decoration: none;
		transition: all 0.3s ease;
		height: 100%;
	}

	.article-card:hover {
		transform: translateY(-5px);
		border-color: var(--color-accent);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
		background: linear-gradient(145deg, rgba(196, 167, 125, 0.05) 0%, rgba(0, 0, 0, 0) 100%);
	}

	.date {
		display: block;
		font-size: 0.85rem;
		color: var(--color-text-muted);
		margin-bottom: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.card-content h2 {
		color: var(--color-text);
		font-size: 1.5rem;
		margin-bottom: 1rem;
		line-height: 1.3;
		transition: color 0.3s;
	}

	.article-card:hover .card-content h2 {
		color: var(--color-accent);
	}

	.card-content p {
		color: rgba(255, 255, 255, 0.8);
		line-height: 1.6;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.read-more {
		color: var(--color-accent);
		font-weight: bold;
		font-size: 0.95rem;
	}
</style>
