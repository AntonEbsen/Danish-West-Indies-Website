---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const historyArticles = await getCollection('history');
	return historyArticles.map(article => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<Layout title={`${article.data.title} | History | Danish West Indies`}>
	<article class="history-article animate-fade-in">
		<a href="/history" class="back-link">← Back to History Portal</a>

		<header class="article-header">
			<span class="article-date">{article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
			<h1>{article.data.title}</h1>
			{article.data.author && <div class="article-author">By {article.data.author}</div>}
		</header>

		<div class="article-content">
			{article.data.description && <p class="lead-desc">{article.data.description}</p>}
			<Content />
		</div>
	</article>
</Layout>

<style>
	.history-article {
		max-width: 800px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-lg);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.article-header {
		text-align: center;
		padding-bottom: var(--space-lg);
		margin-bottom: var(--space-xl);
		border-bottom: 1px solid rgba(196, 167, 125, 0.2);
	}

	.article-date {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.article-header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--color-text);
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.article-author {
		color: var(--color-text-muted);
		font-style: italic;
		font-size: 1.1rem;
	}

	.lead-desc {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.9);
		font-style: italic;
		line-height: 1.6;
		margin-bottom: 2rem;
		padding-left: 1rem;
		border-left: 3px solid var(--color-accent);
	}

	.article-content {
		line-height: 1.8;
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.85);
	}

	.article-content :global(h1), 
	.article-content :global(h2), 
	.article-content :global(h3) {
		color: var(--color-accent);
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		line-height: 1.3;
	}

	.article-content :global(p) {
		margin-bottom: 1.5rem;
	}

	.article-content :global(ul), 
	.article-content :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 2rem;
	}

	.article-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.article-content :global(strong) {
		color: var(--color-text);
	}

	.article-content :global(em) {
		color: var(--color-text-muted);
	}
</style>
