---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const languages = await getCollection('languages');
	return languages.map(lang => ({
		params: { id: lang.id },
		props: { lang },
	}));
}

const { lang } = Astro.props;
const { Content } = await render(lang);
---

<Layout title={`${lang.data.title} | Languages | Danish West Indies`}>
	<article class="language-article animate-fade-in">
		<a href="/languages" class="back-link">← Back to Languages Index</a>
		
		<header class="article-header">
			<div class="lang-meta-top">
				<span class="lang-code">{lang.data.code.toUpperCase()}</span>
				<span class="region">📍 {lang.data.region}</span>
			</div>
			
			<h1>{lang.data.title}</h1>
			<p class="description-lead">{lang.data.description}</p>
		</header>

		<div class="article-content">
			<Content />
		</div>

		<footer class="article-footer">
			<div class="note">
				<p>This digital humanities project aims to restore the historical context of the transatlantic slave trade. By making the archives available across multiple languages, we hope to bridge the gaps created by colonial boundaries.</p>
			</div>
		</footer>
	</article>
</Layout>

<style>
	.language-article {
		max-width: 800px;
		margin: 0 auto;
		padding: var(--space-xl) 0 var(--space-2xl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-xl);
		color: var(--color-accent);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-size: 0.85rem;
		transition: color 0.3s;
	}

	.back-link:hover {
		color: #d4b88f;
	}

	.article-header {
		margin-bottom: var(--space-2xl);
		border-bottom: 1px solid rgba(196, 167, 125, 0.2);
		padding-bottom: var(--space-xl);
	}

	.lang-meta-top {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.lang-code {
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-heading);
		font-weight: bold;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-size: 0.9rem;
	}

	.region {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	h1 {
		color: var(--color-accent);
		font-size: 3.5rem;
		line-height: 1.1;
		margin-bottom: 1rem;
	}

	.description-lead {
		font-size: 1.25rem;
		color: var(--color-text-muted);
		font-style: italic;
		line-height: 1.5;
	}

	.article-content {
		font-size: 1.1rem;
		line-height: 1.8;
		color: rgba(255, 255, 255, 0.85);
		margin-bottom: var(--space-2xl);
	}

	.article-content p {
		margin-bottom: 1.5rem;
	}

	.article-content :global(h2), .article-content :global(h3) {
		color: var(--color-accent);
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}

	.article-footer {
		margin-top: var(--space-2xl);
		padding-top: var(--space-xl);
		border-top: 1px solid rgba(196, 167, 125, 0.2);
	}

	.note {
		background: rgba(196, 167, 125, 0.05);
		border-left: 4px solid var(--color-accent);
		padding: var(--space-lg);
		border-radius: 0 8px 8px 0;
	}

	.note p {
		margin: 0;
		font-style: italic;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}
</style>
