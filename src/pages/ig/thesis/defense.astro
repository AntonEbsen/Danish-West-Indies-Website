---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Thesis Defense | Master Thesis | Danish West Indies">
	<div class="page-container animate-fade-in">
		<a href="/thesis" class="back-link">← Back to Thesis Portal</a>

		<header class="page-header">
			<span class="label">Oral Examination</span>
			<h1>Thesis Defense</h1>
			<p class="subtitle">Documentation of the final academic presentation at the University of Copenhagen.</p>
		</header>

		<div class="defense-status">
			<div class="status-badge pending">Status: Pending Scheduling</div>
			<p>The oral defense will take place following the formal submission of the manuscript. Once completed, a recording (if permitted) and summary will be available here.</p>
		</div>

		<div class="video-placeholder">
			<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="play-icon"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
			<p>Video Recording Unavailable</p>
		</div>

		<div class="defense-details">
			<div class="detail-card">
				<h3>Expected Format</h3>
				<ul>
					<li><strong>Location:</strong> University of Copenhagen, South Campus</li>
					<li><strong>Duration:</strong> 45 minutes presentation, 45 minutes examination</li>
					<li><strong>Format:</strong> Public defense (open to attendees)</li>
				</ul>
			</div>
			<div class="detail-card">
				<h3>Committee</h3>
				<ul>
					<li><strong>Primary Advisor:</strong> [To be determined]</li>
					<li><strong>External Examiner:</strong> [To be determined]</li>
				</ul>
			</div>
		</div>

		<section class="qa-section">
			<h2>Q&A Transcript</h2>
			<p class="empty-state">This section will be populated with a transcript of the most critical questions posed by the examination committee and our responses.</p>
		</section>
	</div>
</Layout>

<style>
	.page-container {
		max-width: 900px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-lg);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.back-link:hover { color: var(--color-accent); }

	.page-header {
		text-align: center;
		margin-bottom: var(--space-xl);
	}

	.label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.page-header h1 {
		color: var(--color-accent);
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 1.1rem;
		font-style: italic;
	}

	.defense-status {
		text-align: center;
		background: rgba(196, 167, 125, 0.05);
		border: 1px solid rgba(196, 167, 125, 0.2);
		border-radius: 8px;
		padding: 1.5rem;
		margin-bottom: var(--space-2xl);
	}

	.status-badge {
		display: inline-block;
		font-weight: bold;
		padding: 0.4rem 1rem;
		border-radius: 4px;
		margin-bottom: 1rem;
	}

	.status-badge.pending {
		background: rgba(234, 179, 8, 0.2);
		color: #eab308;
		border: 1px solid rgba(234, 179, 8, 0.5);
	}

	.defense-status p {
		color: rgba(255, 255, 255, 0.8);
		margin: 0;
	}

	.video-placeholder {
		width: 100%;
		aspect-ratio: 16/9;
		background: #000;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		margin-bottom: var(--space-2xl);
		color: var(--color-text-muted);
	}

	.play-icon {
		margin-bottom: 1rem;
		opacity: 0.5;
	}

	.defense-details {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-lg);
		margin-bottom: var(--space-2xl);
	}

	@media (max-width: 768px) {
		.defense-details {
			grid-template-columns: 1fr;
		}
	}

	.detail-card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 8px;
		padding: var(--space-lg);
	}

	.detail-card h3 {
		color: var(--color-text);
		margin-bottom: 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding-bottom: 0.5rem;
	}

	.detail-card ul {
		list-style: none;
		padding: 0;
		margin: 0;
		color: rgba(255, 255, 255, 0.8);
	}

	.detail-card li {
		margin-bottom: 0.5rem;
		line-height: 1.5;
	}

	.detail-card strong {
		color: var(--color-accent);
	}

	.qa-section h2 {
		color: var(--color-text);
		margin-bottom: 1rem;
	}

	.empty-state {
		font-style: italic;
		color: var(--color-text-muted);
		padding: var(--space-xl);
		border: 1px dashed rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		text-align: center;
	}
</style>
