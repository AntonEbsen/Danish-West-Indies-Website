---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Interactive Maps | Master Thesis | Danish West Indies">
	<!-- Leaflet CSS -->
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

	<div class="page-container animate-fade-in">
		<a href="/thesis" class="back-link">← Back to Thesis Portal</a>

		<header class="page-header">
			<span class="label">Interactive Feature</span>
			<h1>Historical GIS Maps</h1>
			<p class="subtitle">Spatial analysis of plantations, historical sites, and the 1848 rebellion routes across the Danish West Indies.</p>
		</header>

		<div class="map-container">
			<div id="historicalMap"></div>
		</div>

		<div class="map-legend">
			<h2>Map Key & Historical Notes</h2>
			<ul class="legend-list">
				<li><span class="dot c-red"></span> <strong>Fort Frederik (Frederiksted)</strong>: The site where Governor General Peter von Scholten declared emancipation on July 3, 1848, following the uprising led by General Buddhoe.</li>
				<li><span class="dot c-gold"></span> <strong>Christiansted</strong>: The former capital of the Danish West Indies and the center of colonial administration.</li>
				<li><span class="dot c-blue"></span> <strong>Cruz Bay (St. John)</strong>: Site of significant historical importance, including the 1733 Akwamu (Amina) slave rebellion.</li>
			</ul>
			<p class="methodology-note">Note: This map uses modern cartography tiles overlaid with historical coordinates to demonstrate spatial relationships discussed in the thesis.</p>
		</div>
	</div>

	<!-- Leaflet JS -->
	<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const mapEl = document.getElementById('historicalMap');
			if (mapEl) {
				// Initialize map centered on St. Croix
				const map = L.map('historicalMap').setView([17.7276, -64.7470], 10);

				// Add a dark, premium map tile layer (CartoDB Dark Matter)
				L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
					attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
					subdomains: 'abcd',
					maxZoom: 20
				}).addTo(map);

				// Custom Markers
				const createCustomIcon = (color) => {
					return L.divIcon({
						className: 'custom-leaflet-marker',
						html: `<div style="background-color: ${color}; width: 16px; height: 16px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 10px ${color};"></div>`,
						iconSize: [16, 16],
						iconAnchor: [8, 8]
					});
				};

				// Markers
				const locations = [
					{ name: "Fort Frederik (Frederiksted)", coords: [17.7126, -64.8824], color: "#f87171", desc: "Emancipation declared July 3, 1848." },
					{ name: "Christiansted", coords: [17.7466, -64.7032], color: "#c4a77d", desc: "Capital of the Danish West Indies." },
					{ name: "Cruz Bay (St. John)", coords: [18.3313, -64.7937], color: "#38bdf8", desc: "Site of the 1733 Rebellion." },
					{ name: "Charlotte Amalie (St. Thomas)", coords: [18.3419, -64.9307], color: "#c4a77d", desc: "Major port and commercial hub." }
				];

				locations.forEach(loc => {
					L.marker(loc.coords, { icon: createCustomIcon(loc.color) })
						.addTo(map)
						.bindPopup(`<strong style="color:#000;">${loc.name}</strong><br><span style="color:#333;">${loc.desc}</span>`);
				});
			}
		});
	</script>
</Layout>

<style>
	.page-container {
		max-width: 1100px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-lg);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.back-link:hover { color: var(--color-accent); }

	.page-header {
		text-align: center;
		margin-bottom: var(--space-2xl);
	}

	.label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.page-header h1 {
		color: var(--color-accent);
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 1.1rem;
		font-style: italic;
	}

	.map-container {
		height: 600px;
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid rgba(196, 167, 125, 0.3);
		margin-bottom: var(--space-2xl);
		box-shadow: 0 10px 30px rgba(0,0,0,0.3);
	}

	#historicalMap {
		height: 100%;
		width: 100%;
		z-index: 1; /* Keep map behind modals/nav */
	}

	.map-legend {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		padding: var(--space-xl);
	}

	.map-legend h2 {
		color: var(--color-text);
		margin-bottom: 1rem;
		font-size: 1.5rem;
	}

	.legend-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem 0;
	}

	.legend-list li {
		margin-bottom: 0.8rem;
		display: flex;
		align-items: flex-start;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.8);
	}

	.dot {
		display: inline-block;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		margin-right: 12px;
		margin-top: 5px;
		flex-shrink: 0;
	}

	.c-red { background-color: #f87171; box-shadow: 0 0 8px #f87171; }
	.c-gold { background-color: #c4a77d; box-shadow: 0 0 8px #c4a77d; }
	.c-blue { background-color: #38bdf8; box-shadow: 0 0 8px #38bdf8; }

	.methodology-note {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		font-style: italic;
		border-top: 1px dashed rgba(255, 255, 255, 0.1);
		padding-top: 1rem;
	}
</style>
