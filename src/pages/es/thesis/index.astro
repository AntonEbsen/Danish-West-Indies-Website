---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const thesisChapters = await getCollection('thesis');
thesisChapters.sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);
---

<Layout title="Master Thesis | Danish West Indies">
	<div class="page-container animate-fade-in">
		<header class="page-header">
			<span class="label">Academic Portal</span>
			<h1>Master's Thesis</h1>
			<p class="subtitle">Economic History, University of Copenhagen</p>
			<div class="authors">
				<p>Anton Meier Ebsen Jørgensen, Jonas Amasa Skov Nielsen & Sheng Ye Michael Chen</p>
			</div>
		</header>
		
		<section class="thesis-content animate-fade-in" style="animation-delay: 0.2s;">
			<h2>Thesis Chapters</h2>
			<div class="chapter-list">
				{thesisChapters.map((chapter) => (
					<a href={`/thesis/${chapter.id}`} class="chapter-card">
						<div class="chapter-number">
							{chapter.data.chapterNumber.toString().padStart(2, '0')}
						</div>
						<div class="chapter-info">
							<h3>{chapter.data.title}</h3>
							{chapter.data.description && <p>{chapter.data.description}</p>}
						</div>
						<div class="arrow">→</div>
					</a>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-container {
		max-width: 900px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-2xl);
		padding-bottom: var(--space-xl);
		border-bottom: 1px dashed rgba(196, 167, 125, 0.2);
	}

	.label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.page-header h1 {
		color: var(--color-accent);
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--color-text);
		font-size: 1.2rem;
		font-style: italic;
		margin-bottom: 1rem;
	}

	.authors {
		color: var(--color-text-muted);
		font-size: 1rem;
		letter-spacing: 0.5px;
	}

	.thesis-content h2 {
		text-align: center;
		margin-bottom: var(--space-xl);
		font-size: 2rem;
	}

	.chapter-list {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.chapter-card {
		display: flex;
		align-items: center;
		padding: 1.2rem 1.5rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 8px;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.chapter-card:hover {
		transform: translateX(10px);
		background: rgba(196, 167, 125, 0.05);
		border-color: rgba(196, 167, 125, 0.3);
	}

	.chapter-number {
		font-size: 1.5rem;
		font-weight: bold;
		color: rgba(196, 167, 125, 0.4);
		font-family: var(--font-heading);
		margin-right: 1.5rem;
		transition: color 0.3s;
	}

	.chapter-card:hover .chapter-number {
		color: var(--color-accent);
	}

	.chapter-info {
		flex-grow: 1;
	}

	.chapter-info h3 {
		color: var(--color-text);
		font-size: 1.2rem;
		margin: 0 0 0.3rem 0;
		transition: color 0.3s;
	}

	.chapter-card:hover .chapter-info h3 {
		color: var(--color-accent);
	}

	.chapter-info p {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin: 0;
	}

	.arrow {
		color: var(--color-text-muted);
		font-size: 1.2rem;
		transition: transform 0.3s, color 0.3s;
	}

	.chapter-card:hover .arrow {
		transform: translateX(5px);
		color: var(--color-accent);
	}
</style>
