</style>

<script>
	// =============================================
	// 1. Episode Filtering Logic
	// =============================================
	const filterButtons = document.querySelectorAll('.btn-filter');
	const episodes = document.querySelectorAll('.episode-block');

	filterButtons.forEach(button => {
		button.addEventListener('click', () => {
			filterButtons.forEach(btn => btn.classList.remove('active'));
			button.classList.add('active');
			const selectedFilter = button.getAttribute('data-filter');

			episodes.forEach(episode => {
				const category = episode.getAttribute('data-category');
				if (selectedFilter === 'all' || category === selectedFilter) {
					episode.classList.remove('hidden');
					setTimeout(() => {
						(episode as HTMLElement).style.opacity = '1';
						(episode as HTMLElement).style.transform = 'translateY(0)';
					}, 50);
				} else {
					(episode as HTMLElement).style.opacity = '0';
					(episode as HTMLElement).style.transform = 'translateY(10px)';
					setTimeout(() => { episode.classList.add('hidden'); }, 300);
				}
			});
		});
	});

	// =============================================
	// 2. "Continue Watching" Progress Memory
	// =============================================
	const STORAGE_KEY = 'dwi-watched-episodes';

	function getWatchedEpisodes(): string[] {
		try {
			const data = localStorage.getItem(STORAGE_KEY);
			return data ? JSON.parse(data) : [];
		} catch { return []; }
	}

	function saveWatchedEpisodes(watched: string[]) {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(watched));
	}

	function renderWatchedState() {
		const watched = getWatchedEpisodes();
		document.querySelectorAll('.btn-watched').forEach(btn => {
			const epId = btn.getAttribute('data-episode');
			if (!epId) return;

			const block = document.querySelector(`[data-episode-id="${epId}"]`);
			if (watched.includes(epId)) {
				btn.classList.add('is-watched');
				(btn.querySelector('.watch-icon') as HTMLElement).textContent = '✓';
				(btn.querySelector('.watch-text') as HTMLElement).textContent = 'Watched';
				block?.classList.add('watched');
			} else {
				btn.classList.remove('is-watched');
				(btn.querySelector('.watch-icon') as HTMLElement).textContent = '○';
				(btn.querySelector('.watch-text') as HTMLElement).textContent = 'Mark as Watched';
				block?.classList.remove('watched');
			}
		});
	}

	document.querySelectorAll('.btn-watched').forEach(btn => {
		btn.addEventListener('click', () => {
			const epId = btn.getAttribute('data-episode');
			if (!epId) return;
			let watched = getWatchedEpisodes();

			if (watched.includes(epId)) {
				watched = watched.filter(id => id !== epId);
			} else {
				watched.push(epId);
			}
			saveWatchedEpisodes(watched);
			renderWatchedState();
		});
	});

	// Initialize on load
	renderWatchedState();

	// =============================================
	// 3. Social Sharing Links
	// =============================================
	const baseUrl = 'https://danishwestindies.org/thesis/videos';
	document.querySelectorAll('.btn-share').forEach(btn => {
		const platform = btn.getAttribute('data-share');
		const epTitle = btn.getAttribute('data-ep-title') || '';
		const shareText = `Watching a fascinating lecture: "${epTitle}" — on the economic history of Danish colonial slavery. #EconomicHistory #DanishWestIndies`;

		if (platform === 'linkedin') {
			btn.setAttribute('href', `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(baseUrl)}`);
		} else if (platform === 'twitter') {
			btn.setAttribute('href', `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(baseUrl)}`);
		} else if (platform === 'email') {
			btn.setAttribute('href', `mailto:?subject=${encodeURIComponent(epTitle)}&body=${encodeURIComponent(shareText + '\n\n' + baseUrl)}`);
		}
	});
</script>
