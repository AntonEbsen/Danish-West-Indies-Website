const dataCleaningScript = `
import pandas as pd
import numpy as np
from bs4 import BeautifulSoup
import re

def parse_moravian_census(file_path):
    """
    Parses XML transcriptions of the 18th-century Moravian censuses,
    extracting demographic data on enslaved individuals.
    """
    with open(file_path, 'r', encoding='utf-8') as f:
        soup = BeautifulSoup(f, 'xml')
        
    records = []
    # Find all <person> tags in the TEI-XML
    for person in soup.find_all('person'):
        name = person.find('name').text if person.find('name') else 'Unknown'
        
        # Extract origin (e.g., Amina, Creole)
        origin_tag = person.find('trait', type='origin')
        origin = origin_tag.text if origin_tag else 'Not Recorded'
        
        # Calculate age if birth year is present
        birth_tag = person.find('birth')
        birth_year = int(birth_tag['when'][:4]) if birth_tag and 'when' in birth_tag.attrs else np.nan
        
        records.append({
            'name': name,
            'origin': origin,
            'birth_year': birth_year
        })
        
    df = pd.DataFrame(records)
    
    # Clean string data
    df['origin'] = df['origin'].apply(lambda x: re.sub(r'[^a-zA-Z\\s]', '', x).strip())
    
    # Handle missing values using temporal interpolation
    df['birth_year'] = df['birth_year'].interpolate(method='linear')
    
    return df

if __name__ == '__main__':
    raw_data_path = './data/raw/st_croix_1790.xml'
    clean_df = parse_moravian_census(raw_data_path)
    clean_df.to_csv('./data/processed/st_croix_1790_clean.csv', index=False)
    print(f"Successfully processed {len(clean_df)} archival records.")
`;

const networkAnalysisScript = `
import networkx as nx
import pandas as pd
import matplotlib.pyplot as plt

def build_plantation_network(census_df):
    """
    Constructs a spatial network of plantations based on marriage 
    and family ties spanning across different estates.
    """
    G = nx.Graph()
    
    # census_df contains columns: ['person_id', 'estate_id', 'spouse_estate_id']
    for _, row in census_df.dropna(subset=['spouse_estate_id']).iterrows():
        source = row['estate_id']
        target = row['spouse_estate_id']
        
        if G.has_edge(source, target):
            G[source][target]['weight'] += 1
        else:
            G.add_edge(source, target, weight=1)
            
    return G

def calculate_centrality(G):
    # Compute degree centrality to find the most interconnected estates
    centrality = nx.degree_centrality(G)
    return sorted(centrality.items(), key=lambda x: x[1], reverse=True)
`;
