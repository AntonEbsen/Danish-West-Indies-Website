---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const chapters = await getCollection('thesis');
	return chapters.map(chapter => ({
		params: { slug: chapter.id },
		props: { chapter },
	}));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);
---

<Layout title={`${chapter.data.title} | Master Thesis | Danish West Indies`}>
	<article class="chapter-article animate-fade-in">
		<a href="/thesis" class="back-link">← Back to Table of Contents</a>

		<header class="chapter-header">
			<span class="chapter-label">Chapter {chapter.data.chapterNumber.toString().padStart(2, '0')}</span>
			<h1>{chapter.data.title}</h1>
			{chapter.data.description && <p class="chapter-desc">{chapter.data.description}</p>}
		</header>

		<div class="chapter-content">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.chapter-article {
		max-width: 800px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-lg);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.chapter-header {
		text-align: center;
		padding-bottom: var(--space-lg);
		margin-bottom: var(--space-lg);
		border-bottom: 1px solid rgba(196, 167, 125, 0.2);
	}

	.chapter-label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.chapter-header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}

	.chapter-desc {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	.chapter-content {
		line-height: 1.8;
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.9);
	}

	.chapter-content :global(h1), 
	.chapter-content :global(h2), 
	.chapter-content :global(h3) {
		color: var(--color-accent);
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.chapter-content :global(p) {
		margin-bottom: 1.5rem;
	}

	.chapter-content :global(em) {
		color: var(--color-text-muted);
	}
</style>
