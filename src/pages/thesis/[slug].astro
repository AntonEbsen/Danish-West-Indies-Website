---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const chapters = await getCollection('thesis');
	return chapters.map(chapter => ({
		params: { slug: chapter.id },
		props: { chapter },
	}));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);
---

<Layout title={`${chapter.data.title} | Master Thesis | Danish West Indies`}>
	<article class="chapter-article animate-fade-in">
		<a href="/thesis" class="back-link">← Back to Table of Contents</a>

		<header class="chapter-header">
			<span class="chapter-label">Chapter {chapter.data.chapterNumber.toString().padStart(2, '0')}</span>
			<h1>{chapter.data.title}</h1>
			{chapter.data.description && <p class="chapter-desc">{chapter.data.description}</p>}
			
			<button id="btn-summarize" class="ai-summarize-btn" data-slug={chapter.id}>
				✨ Generate AI Summary
			</button>
		</header>

		<div id="ai-summary-container" class="ai-summary-container hidden">
			<div class="ai-summary-header">
				<span class="ai-icon">✨</span>
				<h3>Claude 3.5 Summary</h3>
			</div>
			<div id="ai-summary-content" class="ai-summary-content">
				<!-- Streaming content goes here -->
			</div>
		</div>

		<div class="chapter-content">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.chapter-article {
		max-width: 800px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-lg);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.chapter-header {
		text-align: center;
		padding-bottom: var(--space-lg);
		margin-bottom: var(--space-lg);
		border-bottom: 1px solid rgba(196, 167, 125, 0.2);
	}

	.chapter-label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.chapter-header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}

	.chapter-desc {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	.chapter-content {
		line-height: 1.8;
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.9);
	}

	.chapter-content :global(h1), 
	.chapter-content :global(h2), 
	.chapter-content :global(h3) {
		color: var(--color-accent);
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.chapter-content :global(p) {
		margin-bottom: 1.5rem;
	}

	.chapter-content :global(em) {
		color: var(--color-text-muted);
	}

	/* AI Summary Styles */
	.ai-summarize-btn {
		margin-top: 1.5rem;
		background: linear-gradient(135deg, rgba(196,167,125,0.2), rgba(196,167,125,0.05));
		border: 1px solid rgba(196,167,125,0.4);
		color: var(--color-accent);
		padding: 0.6rem 1.2rem;
		border-radius: 30px;
		font-family: var(--font-heading);
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.ai-summarize-btn:hover {
		background: rgba(196,167,125,0.3);
		transform: translateY(-2px);
		box-shadow: 0 4px 15px rgba(196,167,125,0.2);
	}
	.ai-summarize-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
		transform: none;
	}

	.ai-summary-container {
		background: rgba(30, 30, 30, 0.6);
		border: 1px solid rgba(196,167,125,0.3);
		border-radius: 12px;
		margin-bottom: 2rem;
		overflow: hidden;
		transition: all 0.3s ease;
		box-shadow: 0 10px 30px rgba(0,0,0,0.3);
	}
	.ai-summary-container.hidden {
		display: none;
	}
	.ai-summary-header {
		background: rgba(196,167,125,0.1);
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border-bottom: 1px solid rgba(196,167,125,0.2);
	}
	.ai-summary-header h3 {
		margin: 0;
		color: var(--color-accent);
		font-family: var(--font-heading);
		font-size: 1.2rem;
	}
	.ai-summary-content {
		padding: 1.5rem;
		line-height: 1.6;
		color: rgba(255,255,255,0.9);
		font-size: 1.05rem;
	}
	.ai-summary-content p {
		margin-bottom: 1rem;
	}
	.ai-summary-content ul {
		margin-left: 1.5rem;
		margin-bottom: 1rem;
	}
	.ai-summary-content li {
		margin-bottom: 0.5rem;
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const btn = document.getElementById('btn-summarize');
		const container = document.getElementById('ai-summary-container');
		const content = document.getElementById('ai-summary-content');

		if (btn && container && content) {
			btn.addEventListener('click', async () => {
				const slug = btn.getAttribute('data-slug');
				if (!slug) return;

				btn.disabled = true;
				btn.innerHTML = '✨ Generating...';
				container.classList.remove('hidden');
				content.innerHTML = '<span class="loading-pulse">Thinking...</span>';

				try {
					const response = await fetch('/api/summarize', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ slug })
					});

					if (!response.ok) {
						throw new Error(`HTTP error! status: ${response.status}`);
					}

					// We expect a streamed response from the AI SDK
					const reader = response.body?.getReader();
					const decoder = new TextDecoder();
					let summaryText = '';

					if (reader) {
						content.innerHTML = '';
						while (true) {
							const { done, value } = await reader.read();
							if (done) break;
							
							const chunk = decoder.decode(value, { stream: true });
							summaryText += chunk;
							
							// A very naive markdown renderer for streaming
							let html = summaryText
								.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
								.replace(/\n\n/g, '</p><p>')
								.replace(/\n- (.*)/g, '<li>$1</li>');
							
							// Wrap lists
							html = html.replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>');
							
							if (!html.startsWith('<p>')) html = '<p>' + html;
							if (!html.endsWith('</p>')) html = html + '</p>';

							content.innerHTML = html;
						}
					}
					
					btn.innerHTML = '✨ Summary Generated';
				} catch (error) {
					console.error("Error generating summary:", error);
					content.innerHTML = '<p class="error">Sorry, there was an error generating the summary. Please check if the API key is configured correctly.</p>';
					btn.disabled = false;
					btn.innerHTML = '✨ Try Again';
				}
			});
		}
	});
</script>
