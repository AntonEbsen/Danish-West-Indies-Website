---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Master Thesis - Danish West Indies">
	<div class="page-header animate-fade-in">
		<h1>Master Thesis</h1>
		<p class="subtitle">Economic History, University of Copenhagen</p>
	</div>
	
	<section class="content-section animate-fade-in" style="animation-delay: 0.2s;">
		<h2>Abstract & Introduction</h2>
		<p>The chapters of the thesis will be populated here via Astro Content Collections once the writing process begins.</p>
	</section>
</Layout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-lg);
	}
	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-muted);
		font-family: var(--font-heading);
		font-style: italic;
	}
</style>
