---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const thesisChapters = await getCollection('thesis');
thesisChapters.sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);
---

<Layout title="Master Thesis | Danish West Indies">
	<div class="page-container animate-fade-in">
		<header class="page-header">
			<span class="label">Academic Portal</span>
			<h1>Master's Thesis</h1>
			<p class="subtitle">Economic History, University of Copenhagen</p>
			<div class="authors">
				<p>Anton Meier Ebsen Jørgensen, Jonas Amasa Skov Nielsen & Sheng Ye Michael Chen</p>
			</div>
		</header>
		<section class="portal-features animate-fade-in" style="animation-delay: 0.2s;">
			<h2>Interactive Features</h2>
			<div class="features-grid">
				<a href="/thesis/data-explorer" class="feature-card">
					<div class="fc-icon">📊</div>
					<h3>Data Explorer</h3>
					<p>Interactive visualizations of empirical datasets.</p>
				</a>
				<a href="/thesis/interactive-maps" class="feature-card">
					<div class="fc-icon">🗺️</div>
					<h3>Historical GIS</h3>
					<p>Spatial analysis of plantations and rebellions.</p>
				</a>
				<a href="/thesis/downloads" class="feature-card">
					<div class="fc-icon">⬇️</div>
					<h3>Downloads</h3>
					<p>Access raw datasets, code, and thesis PDFs.</p>
				</a>
				<a href="/thesis/defense" class="feature-card">
					<div class="fc-icon">🎓</div>
					<h3>Thesis Defense</h3>
					<p>Oral examination documentation and slides.</p>
				</a>
				<a href="/thesis/authors" class="feature-card">
					<div class="fc-icon">👥</div>
					<h3>The Authors</h3>
					<p>Biographies and division of academic labor.</p>
				</a>
				<a href="/thesis/glossary" class="feature-card">
					<div class="fc-icon">📖</div>
					<h3>Glossary</h3>
					<p>Searchable dictionary of historical colonial terminology.</p>
				</a>
				<a href="/thesis/behind-the-code" class="feature-card">
					<div class="fc-icon">💻</div>
					<h3>Behind the Code</h3>
					<p>Explore the Python scripts powering our data extraction.</p>
				</a>
			</div>
		</section>

		<section class="thesis-content animate-fade-in" style="animation-delay: 0.3s;">
			<h2>Thesis Chapters</h2>
			<div class="chapter-list">
				{thesisChapters.map((chapter) => (
					<a href={`/thesis/${chapter.id}`} class="chapter-card">
						<div class="chapter-number">
							{chapter.data.chapterNumber.toString().padStart(2, '0')}
						</div>
						<div class="chapter-info">
							<h3>{chapter.data.title}</h3>
							{chapter.data.description && <p>{chapter.data.description}</p>}
						</div>
						<div class="arrow">→</div>
					</a>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-container {
		max-width: 900px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-2xl);
		padding-bottom: var(--space-xl);
		border-bottom: 1px dashed rgba(196, 167, 125, 0.2);
	}

	.label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.page-header h1 {
		color: var(--color-accent);
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--color-text);
		font-size: 1.2rem;
		font-style: italic;
		margin-bottom: 1rem;
	}

	.authors {
		color: var(--color-text-muted);
		font-size: 1rem;
		letter-spacing: 0.5px;
	}

	.portal-features {
		margin-bottom: var(--space-2xl);
		padding-bottom: var(--space-xl);
		border-bottom: 1px dashed rgba(196, 167, 125, 0.2);
	}

	.portal-features h2, .thesis-content h2 {
		text-align: center;
		margin-bottom: var(--space-xl);
		font-size: 2rem;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 1rem;
	}

	.feature-card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(196, 167, 125, 0.2);
		border-radius: 8px;
		padding: 1.5rem 1rem;
		text-align: center;
		text-decoration: none;
		transition: all 0.3s ease;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.feature-card:hover {
		transform: translateY(-5px);
		border-color: var(--color-accent);
		background: rgba(196, 167, 125, 0.05);
	}

	.fc-icon {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.feature-card h3 {
		color: var(--color-accent);
		font-size: 1.1rem;
		margin: 0 0 0.5rem 0;
	}

	.feature-card p {
		color: var(--color-text-muted);
		font-size: 0.85rem;
		margin: 0;
		line-height: 1.4;
	}

	.chapter-list {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.chapter-card {
		display: flex;
		align-items: center;
		padding: 1.2rem 1.5rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 8px;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.chapter-card:hover {
		transform: translateX(10px);
		background: rgba(196, 167, 125, 0.05);
		border-color: rgba(196, 167, 125, 0.3);
	}

	.chapter-number {
		font-size: 1.5rem;
		font-weight: bold;
		color: rgba(196, 167, 125, 0.4);
		font-family: var(--font-heading);
		margin-right: 1.5rem;
		transition: color 0.3s;
	}

	.chapter-card:hover .chapter-number {
		color: var(--color-accent);
	}

	.chapter-info {
		flex-grow: 1;
	}

	.chapter-info h3 {
		color: var(--color-text);
		font-size: 1.2rem;
		margin: 0 0 0.3rem 0;
		transition: color 0.3s;
	}

	.chapter-card:hover .chapter-info h3 {
		color: var(--color-accent);
	}

	.chapter-info p {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin: 0;
	}

	.arrow {
		color: var(--color-text-muted);
		font-size: 1.2rem;
		transition: transform 0.3s, color 0.3s;
	}

	.chapter-card:hover .arrow {
		transform: translateX(5px);
		color: var(--color-accent);
	}
</style>
