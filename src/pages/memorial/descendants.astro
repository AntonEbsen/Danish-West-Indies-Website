---
import Layout from '../../layouts/Layout.astro';
import AmbientSound from '../../components/AmbientSound.astro';

const descendants = [
  {
    name: "Placeholder Descendant 1",
    ancestor: "General Buddhoe",
    quote: "My grandfather always told me stories of the man who marched on the fort. For a long time, it felt like myth, until I started looking into the archives.",
    location: "St. Croix, USVI",
    image: "https://images.unsplash.com/photo-1531384441138-2736e62e0919?q=80&w=800&auto=format&fit=crop"
  },
  {
    name: "Placeholder Descendant 2",
    ancestor: "Queen Mary Thomas",
    quote: "We were taught in school about the queens, but to know that her blood is my blood gives me a strength I cannot fully describe.",
    location: "Copenhagen, Denmark",
    image: "https://images.unsplash.com/photo-1507152832244-10d45c7eda57?q=80&w=800&auto=format&fit=crop"
  },
  {
    name: "Placeholder Descendant 3",
    ancestor: "Breffu",
    quote: "She led a revolution on St. John, and though the history books tried to forget her, our families never did.",
    location: "St. John, USVI",
    image: "https://images.unsplash.com/photo-1522529599102-193c0d76b5b6?q=80&w=800&auto=format&fit=crop"
  }
];
---

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<Layout title="Descendants' Voices | Danish West Indies">
	<div class="descendants-page">
		<header class="page-header animate-fade-in">
			<a href="/memorial" class="back-link">← Back to Register</a>
			<h1>The Living Legacy</h1>
			<p class="subtitle">Voices of the descendants, proving that their lineage survived and thrived.</p>
		</header>

		<section class="diaspora-map-section animate-fade-in" style="animation-delay: 0.2s;">
			<h2>Map of the Diaspora</h2>
			<p>See where the descendants of the Danish West Indies reside today.</p>
			<div id="diaspora-map" class="diaspora-map"></div>
		</section>

		<div class="gallery-container">
			{descendants.map((person, index) => (
				<article class="descendant-card animate-fade-in" style={`animation-delay: ${index * 0.2}s;`}>
					<div class="card-image" style={`background-image: url('${person.image}')`}>
						<!-- Audio Visualizer Overlay -->
						<div class="audio-visualizer hidden">
							<div class="bar"></div>
							<div class="bar"></div>
							<div class="bar"></div>
							<div class="bar"></div>
							<div class="bar"></div>
						</div>
						<button class="btn-play-audio" title="Play Testimony" aria-label="Play Testimony">
							<span class="icon">▶</span>
						</button>
					</div>
					<div class="card-content">
						<blockquote>"{person.quote}"</blockquote>
						<div class="card-meta">
							<h3>{person.name}</h3>
							<span class="location">{person.location}</span>
							<span class="ancestor">Descendant of <strong>{person.ancestor}</strong></span>
						</div>
					</div>
				</article>
			))}
		</div>
		
		<div class="call-to-action animate-fade-in" style="animation-delay: 1s;">
			<p>Are you a descendant? We want to hear your story.</p>
			<a href="/contribute" class="btn-primary">Share Your Story</a>
		</div>
	</div>

	<AmbientSound />
</Layout>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Initialize Diaspora Map
		const mapContainer = document.getElementById('diaspora-map');
		if (mapContainer && typeof window !== 'undefined' && window.L) {
			// Center somewhere in the Atlantic to show US/Caribbean/Europe
			const map = window.L.map('diaspora-map').setView([35, -40], 3);
			
			// Dark theme map tiles
			window.L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
				attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
				subdomains: 'abcd',
				maxZoom: 20
			}).addTo(map);

			// Add some placeholder markers
			const locations = [
				{ name: "St. Croix, USVI", coords: [17.7246, -64.8317] },
				{ name: "Copenhagen, Denmark", coords: [55.6761, 12.5683] },
				{ name: "St. John, USVI", coords: [18.3368, -64.7281] },
				{ name: "New York, USA", coords: [40.7128, -74.0060] }
			];

			locations.forEach(loc => {
				window.L.circleMarker(loc.coords, {
					color: '#c4a77d',
					fillColor: '#c4a77d',
					fillOpacity: 0.5,
					radius: 8
				}).addTo(map).bindPopup(`<b>${loc.name}</b>`);
			});
		}

		// Audio Play Button Logic
		document.querySelectorAll('.btn-play-audio').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const currentBtn = e.currentTarget as HTMLButtonElement;
				const icon = currentBtn.querySelector('.icon');
				const visualizer = currentBtn.parentElement?.querySelector('.audio-visualizer');
				
				if (currentBtn.classList.contains('playing')) {
					currentBtn.classList.remove('playing');
					if(icon) icon.textContent = '▶';
					visualizer?.classList.add('hidden');
				} else {
					// Stop all others
					document.querySelectorAll('.btn-play-audio.playing').forEach(otherBtn => {
						otherBtn.classList.remove('playing');
						const otherIcon = otherBtn.querySelector('.icon');
						if(otherIcon) otherIcon.textContent = '▶';
						otherBtn.parentElement?.querySelector('.audio-visualizer')?.classList.add('hidden');
					});

					// Play this one
					currentBtn.classList.add('playing');
					if(icon) icon.textContent = '⏸';
					visualizer?.classList.remove('hidden');
				}
			});
		});
	});
</script>

<style>
	.descendants-page {
		max-width: 1200px;
		margin: 0 auto;
		padding: var(--space-xl) var(--space-md);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-xl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-md);
		color: rgba(196, 167, 125, 0.6);
		text-transform: uppercase;
		letter-spacing: 2px;
		font-size: 0.9rem;
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.page-header h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		color: var(--color-accent);
		margin-bottom: var(--space-xs);
	}

	.subtitle {
		font-size: 1.2rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	.gallery-container {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: var(--space-xl);
		margin-bottom: var(--space-xl);
	}

	.descendant-card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(196, 167, 125, 0.1);
		border-radius: 8px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform var(--transition-normal);
	}

	.descendant-card:hover {
		transform: translateY(-5px);
		border-color: rgba(196, 167, 125, 0.3);
	}

	.card-image {
		height: 300px;
		background-size: cover;
		background-position: center;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.card-image::after {
		content: '';
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.8) 100%);
	}

	/* Audio Visualizer */
	.audio-visualizer {
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		background: rgba(0, 0, 0, 0.7);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		z-index: 1;
		transition: opacity var(--transition-fast);
	}

	.audio-visualizer.hidden {
		opacity: 0;
		pointer-events: none;
	}

	.audio-visualizer .bar {
		width: 8px;
		height: 10px;
		background: var(--color-accent);
		border-radius: 4px;
		animation: eq 1s ease-in-out infinite alternate;
	}

	.audio-visualizer .bar:nth-child(1) { animation-delay: 0.1s; }
	.audio-visualizer .bar:nth-child(2) { animation-delay: 0.3s; }
	.audio-visualizer .bar:nth-child(3) { animation-delay: 0.0s; }
	.audio-visualizer .bar:nth-child(4) { animation-delay: 0.4s; }
	.audio-visualizer .bar:nth-child(5) { animation-delay: 0.2s; }

	@keyframes eq {
		0% { height: 10px; }
		100% { height: 80px; }
	}

	.btn-play-audio {
		background: rgba(0, 0, 0, 0.6);
		border: 2px solid var(--color-accent);
		color: var(--color-accent);
		width: 60px;
		height: 60px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 2;
		transition: all var(--transition-fast);
		backdrop-filter: blur(4px);
	}

	.btn-play-audio:hover {
		background: var(--color-accent);
		color: #000;
		transform: scale(1.1);
	}

	.btn-play-audio .icon {
		margin-left: 5px; /* Visual center for play button */
		font-size: 1.2rem;
	}

	.card-content {
		padding: var(--space-lg);
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	blockquote {
		font-size: 1.1rem;
		line-height: 1.6;
		font-style: italic;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: var(--space-lg);
		flex: 1;
	}

	.card-meta {
		border-top: 1px solid rgba(196, 167, 125, 0.1);
		padding-top: var(--space-md);
	}

	.card-meta h3 {
		font-size: 1.2rem;
		color: var(--color-accent);
		margin-bottom: 0.2rem;
	}

	.location {
		display: block;
		font-size: 0.9rem;
		color: var(--color-text-muted);
		margin-bottom: 0.8rem;
	}

	.ancestor {
		display: inline-block;
		background: rgba(196, 167, 125, 0.1);
		padding: 0.4rem 0.8rem;
		border-radius: 20px;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.8);
	}

	.ancestor strong {
		color: var(--color-accent);
	}

	.call-to-action {
		text-align: center;
		margin-top: 4rem;
		padding: 3rem;
		background: rgba(196, 167, 125, 0.05);
		border-radius: 8px;
		border: 1px dashed rgba(196, 167, 125, 0.3);
	}

	.call-to-action p {
		font-size: 1.2rem;
		margin-bottom: var(--space-md);
		color: var(--color-text-muted);
	}

	.btn-primary {
		display: inline-block;
		background: var(--color-accent);
		color: #111;
		padding: 0.8rem 2rem;
		border-radius: 4px;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 1px;
		transition: all var(--transition-fast);
	}

	.btn-primary:hover {
		background: #d4b88f;
		transform: translateY(-2px);
	}

	/* Diaspora Map Styles */
	.diaspora-map-section {
		margin-bottom: var(--space-xl);
		text-align: center;
	}
	
	.diaspora-map-section h2 {
		color: var(--color-accent);
		font-size: 2rem;
		margin-bottom: var(--space-xs);
	}

	.diaspora-map-section p {
		color: var(--color-text-muted);
		margin-bottom: var(--space-md);
	}

	.diaspora-map {
		width: 100%;
		height: 400px;
		border-radius: 8px;
		border: 1px solid rgba(196, 167, 125, 0.3);
		z-index: 1; /* Keep leaflet below modals/headers */
	}
</style>
