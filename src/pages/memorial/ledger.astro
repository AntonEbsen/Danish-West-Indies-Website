---
import Layout from '../../layouts/Layout.astro';
import AmbientSound from '../../components/AmbientSound.astro';
import { getCollection } from 'astro:content';

const memorialEntries = await getCollection('memorial');
// Sort by name for the ledger
memorialEntries.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout title="The Raw Ledger | Danish West Indies">
	<div class="ledger-page">
		<header class="page-header animate-fade-in">
			<a href="/memorial" class="back-link">← Back to Register</a>
			<h1>The Raw Ledger</h1>
			<p class="subtitle">A reflection of the archives. This is how colonial systems quantified human lives.</p>
		</header>

		<div class="ledger-toolbar animate-fade-in" style="animation-delay: 0.3s;">
			<div class="toolbar-group">
				<label for="sort-select">Sort By:</label>
				<select id="sort-select">
					<option value="name">Name (A-Z)</option>
					<option value="year-asc">Birth Year (Oldest)</option>
					<option value="year-desc">Birth Year (Newest)</option>
				</select>
			</div>
			
			<div class="toolbar-group">
				<label class="toggle-switch">
					<input type="checkbox" id="font-toggle">
					<span class="slider"></span>
					<span class="toggle-label">View Original Script</span>
				</label>
			</div>
		</div>

		<div class="ledger-container animate-fade-in" style="animation-delay: 0.5s;">
			<div class="ledger-paper">
				<table class="ledger-table">
					<thead>
						<tr>
							<th>Record ID</th>
							<th>Name / Moniker</th>
							<th>Origin / Ethnicity</th>
							<th>Location / Plantation</th>
							<th>Birth Year</th>
							<th>Death Year</th>
							<th>Archival Notes</th>
						</tr>
					</thead>
					<tbody id="ledger-body">
						{memorialEntries.map((entry) => (
							<tr class="ledger-row" data-name={entry.data.name} data-year={entry.data.yearOfBirth || 9999}>
								<td class="col-id">{entry.id}</td>
								<td class="col-name"><a href={`/memorial/${entry.id}`}>{entry.data.name}</a></td>
								<td>{entry.data.origin || 'Unknown'}</td>
								<td>{entry.data.location || 'Unknown'}</td>
								<td class="col-num">{entry.data.yearOfBirth || '—'}</td>
								<td class="col-num">{entry.data.yearOfDeath || '—'}</td>
								<td class="col-notes">{entry.data.notes || '—'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			
			<div class="ledger-caption">
				<p>The stark reality of historical records. While the archives attempted to reduce them to property and statistics, this register restores their humanity.</p>
			</div>
		</div>
	</div>

	<AmbientSound />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
		const tbody = document.getElementById('ledger-body');
		const fontToggle = document.getElementById('font-toggle') as HTMLInputElement;
		const table = document.querySelector('.ledger-table');

		// Sorting Logic
		sortSelect?.addEventListener('change', (e) => {
			if (!tbody) return;
			const target = e.target as HTMLSelectElement;
			const rows = Array.from(tbody.querySelectorAll('.ledger-row')) as HTMLElement[];
			
			rows.sort((a, b) => {
				if (target.value === 'name') {
					const nameA = a.getAttribute('data-name') || '';
					const nameB = b.getAttribute('data-name') || '';
					return nameA.localeCompare(nameB);
				} else if (target.value === 'year-asc') {
					const yearA = parseInt(a.getAttribute('data-year') || '9999');
					const yearB = parseInt(b.getAttribute('data-year') || '9999');
					return yearA - yearB;
				} else if (target.value === 'year-desc') {
					const yearA = parseInt(a.getAttribute('data-year') || '0');
					const yearB = parseInt(b.getAttribute('data-year') || '0');
					return yearB - yearA;
				}
				return 0;
			});

			// Re-append in sorted order
			rows.forEach(row => tbody.appendChild(row));
		});

		// Font Toggle Logic
		fontToggle?.addEventListener('change', (e) => {
			const target = e.target as HTMLInputElement;
			if (target.checked) {
				table?.classList.add('cursive-mode');
			} else {
				table?.classList.remove('cursive-mode');
			}
		});
	});
</script>

<style>
	.ledger-page {
		min-height: 100vh;
		background: #111;
		padding: var(--space-xl) var(--space-md);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-xl);
		max-width: 800px;
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-md);
		color: rgba(196, 167, 125, 0.6);
		text-transform: uppercase;
		letter-spacing: 2px;
		font-size: 0.9rem;
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.page-header h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		color: var(--color-accent);
		margin-bottom: var(--space-xs);
	}

	.subtitle {
		font-size: 1.2rem;
		color: var(--color-text-muted);
		font-style: italic;
	}

	.ledger-container {
		width: 100%;
		max-width: 1200px;
		overflow-x: auto;
		margin-bottom: 4rem;
	}

	/* Aged Paper Effect */
	.ledger-paper {
		background-color: #f4ecd8; /* Sepia/Aged paper base */
		background-image: 
			linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);
		background-size: 20px 20px;
		padding: 2rem;
		border: 1px solid #d4c5a3;
		box-shadow: 
			inset 0 0 50px rgba(0,0,0,0.1),
			0 10px 30px rgba(0,0,0,0.5);
		border-radius: 2px;
	}

	.ledger-table {
		width: 100%;
		border-collapse: collapse;
		color: #2b2520; /* Dark brown ink */
		font-family: "Courier New", Courier, monospace; /* Monospaced for ledger feel */
		font-size: 0.95rem;
	}

	.ledger-table th, .ledger-table td {
		border: 1px solid rgba(43, 37, 32, 0.3); /* Faded ink borders */
		padding: 0.8rem;
		text-align: left;
		vertical-align: top;
	}

	.ledger-table th {
		background: rgba(43, 37, 32, 0.05);
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-size: 0.85rem;
		border-bottom: 2px solid rgba(43, 37, 32, 0.5);
	}

	.ledger-table tr:nth-child(even) {
		background: rgba(255, 255, 255, 0.3);
	}

	.ledger-table tr:hover {
		background: rgba(196, 167, 125, 0.2);
	}

	.col-id {
		color: #665b50;
		font-size: 0.85rem;
	}

	.col-name a {
		color: #2b2520;
		font-weight: bold;
		text-decoration: underline;
		text-decoration-color: rgba(43, 37, 32, 0.3);
		transition: all var(--transition-fast);
	}

	.col-name a:hover {
		color: #8b1e1e; /* Red ink on hover */
		text-decoration-color: #8b1e1e;
	}

	.col-num {
		text-align: center;
		font-style: italic;
	}

	.col-notes {
		font-family: "Times New Roman", Times, serif; /* Mixed font for notes */
		font-style: italic;
		font-size: 1.05rem;
		max-width: 300px;
	}

	/* Cursive Mode */
	.ledger-table.cursive-mode {
		font-family: 'Brush Script MT', 'Lucida Handwriting', cursive;
		font-size: 1.3rem;
		opacity: 0.8;
	}

	.ledger-table.cursive-mode .col-notes {
		font-family: inherit;
		font-size: 1.4rem;
	}

	.ledger-table.cursive-mode th {
		font-family: "Courier New", Courier, monospace; /* Keep headers readable */
		opacity: 1;
	}

	/* Toolbar */
	.ledger-toolbar {
		display: flex;
		gap: var(--space-xl);
		margin-bottom: var(--space-lg);
		background: rgba(255, 255, 255, 0.05);
		padding: 1rem 2rem;
		border-radius: 8px;
		border: 1px solid rgba(196, 167, 125, 0.2);
		align-items: center;
		flex-wrap: wrap;
	}

	.toolbar-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.toolbar-group label {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 1px;
	}

	select {
		background: rgba(0,0,0,0.5);
		color: #fff;
		border: 1px solid rgba(196, 167, 125, 0.5);
		padding: 0.5rem;
		border-radius: 4px;
		font-family: var(--font-body);
	}

	/* Toggle Switch */
	.toggle-switch {
		position: relative;
		display: flex;
		align-items: center;
		cursor: pointer;
	}

	.toggle-switch input {
		opacity: 0;
		width: 0;
		height: 0;
	}

	.slider {
		position: relative;
		display: inline-block;
		width: 40px;
		height: 20px;
		background-color: rgba(255,255,255,0.2);
		border-radius: 20px;
		transition: .4s;
		margin-right: 10px;
	}

	.slider:before {
		position: absolute;
		content: "";
		height: 16px;
		width: 16px;
		left: 2px;
		bottom: 2px;
		background-color: white;
		border-radius: 50%;
		transition: .4s;
	}

	input:checked + .slider {
		background-color: var(--color-accent);
	}

	input:checked + .slider:before {
		transform: translateX(20px);
		background-color: #000;
	}

	.toggle-label {
		color: rgba(255,255,255,0.8) !important;
	}

	.ledger-caption {
		text-align: center;
		margin-top: var(--space-xl);
		color: rgba(255,255,255,0.5);
		font-style: italic;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}
</style>
