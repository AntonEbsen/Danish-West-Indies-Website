---
import Layout from '../../layouts/Layout.astro';
import AmbientSound from '../../components/AmbientSound.astro';

const ships = [
  {
    name: "Cron-Printz Christian",
    year: "1708",
    embarked: 310,
    died: 70
  },
  {
    name: "Grevinde af Laurvig",
    year: "1717",
    embarked: 350,
    died: 80
  },
  {
    name: "Fredensborg",
    year: "1767",
    embarked: 265,
    died: 30
  }
];

// Calculate total known loss from this small sample
const totalLost = ships.reduce((acc, ship) => acc + ship.died, 0);

const shipModals = {
  "Cron-Printz Christian": "Manifest Log (1708): 'Provisions running low. Sickness spreading rapidly among the cargo in the hold. We have been forced to jettison several souls to the sea.'",
  "Grevinde af Laurvig": "Captain's Log (1717): 'A fierce storm delayed our crossing by three weeks. The mortality rate is unacceptable for the company's margins.'",
  "Fredensborg": "Excerpt from the surviving manifest (1767): 'Embarked 265 slaves at Osu Castle. Arrived at St. Croix with 235 remaining. The loss is regrettable but expected on this route.'"
};
---

<Layout title="The Voyage - The Middle Passage | Danish West Indies">
	<div class="ocean-container">
		<!-- Ocean Wave Animation Background -->
		<div class="wave wave1"></div>
		<div class="wave wave2"></div>
		<div class="wave wave3"></div>
		
		<div class="overlay"></div>

		<!-- Audio Initializer Overlay -->
		<div id="audio-start-overlay" class="audio-start-overlay">
			<button id="btn-start-voyage" class="btn-start-voyage">Begin the Journey</button>
			<p>Please ensure your sound is on.</p>
		</div>

		<div class="voyage-content">
			<header class="voyage-header animate-fade-in">
				<a href="/memorial" class="back-link">← Back to Register</a>
				<h1>The Voyage</h1>
				<p class="subtitle">Honoring those who never reached the shores.</p>
			</header>

			<section class="intro-section animate-fade-in" style="animation-delay: 1s;">
				<p>Before the Danish West Indies, there was the ocean.</p>
				<p>For centuries, ships of the Danish West India and Guinea Company carried captured men, women, and children across the Atlantic in the brutal journey known as the Middle Passage.</p>
				<p>This space honors the countless souls who perished at sea—their names unrecorded, their resting place the deep.</p>
			</section>

			<div class="ships-container">
				{ships.map((ship, index) => (
					<button class="ship-record scrolly-item" style={`animation-delay: ${index * 0.5}s;`} data-ship={ship.name} data-quote={shipModals[ship.name as keyof typeof shipModals]}>
						<h2>Ship: <em>{ship.name}</em></h2>
						<div class="ship-details">
							<span class="year">Year: {ship.year}</span>
							<div class="stats">
								<div class="stat">
									<span class="label">Embarked from West Africa</span>
									<span class="value">{ship.embarked} lives</span>
								</div>
								<div class="stat tragic">
									<span class="label">Lost at Sea</span>
									<span class="value">{ship.died} souls</span>
								</div>
							</div>
						</div>
						<div class="click-hint">Click to read archival notes</div>
					</button>
				))}
			</div>

			<footer class="voyage-footer scrolly-item">
				<p class="summary">From just these three recorded voyages, <strong>{totalLost}</strong> individuals were lost to the ocean.</p>
				<p class="summary">They are not forgotten.</p>
				
				<a href="/memorial" class="btn-proceed">Enter the Memorial Register</a>
			</footer>
		</div>
	</div>

	<!-- Ship Modal -->
	<dialog id="ship-modal" class="ship-modal">
		<div class="modal-inner">
			<button id="close-modal" class="close-modal">&times;</button>
			<h3 id="modal-title">Ship Name</h3>
			<div class="modal-body">
				<p id="modal-quote">Quote goes here...</p>
			</div>
			<div class="modal-footer">
				<span>Source: Royal Danish Archives</span>
			</div>
		</div>
	</dialog>

	<AmbientSound />
</Layout>

	<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Scrollytelling setup
		const observer = new IntersectionObserver((entries, observer) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		}, {
			root: null,
			rootMargin: '0px 0px -50px 0px',
			threshold: 0.1
		});

		document.querySelectorAll('.scrolly-item').forEach(el => observer.observe(el));

		// Audio API Setup
		let audioCtx: AudioContext | null = null;
		let gainNode: GainNode | null = null;
		const startBtn = document.getElementById('btn-start-voyage');
		const overlay = document.getElementById('audio-start-overlay');

		startBtn?.addEventListener('click', () => {
			if (!audioCtx) {
				audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
				
				// Create the "heartbeat" oscillator
				const osc = audioCtx.createOscillator();
				osc.type = 'sine';
				osc.frequency.setValueAtTime(40, audioCtx.currentTime); // Low frequency thrum
				
				// Create gain node for volume control via scroll
				gainNode = audioCtx.createGain();
				gainNode.gain.setValueAtTime(0, audioCtx.currentTime);
				
				osc.connect(gainNode);
				gainNode.connect(audioCtx.destination);
				osc.start();

				// Setup heartbeat pulsing using another oscillator to modulate amplitude
				const lfo = audioCtx.createOscillator();
				lfo.type = 'sine';
				lfo.frequency.setValueAtTime(1.2, audioCtx.currentTime); // ~72 beats per minute
				
				const lfoGain = audioCtx.createGain();
				lfoGain.gain.setValueAtTime(0.5, audioCtx.currentTime);
				
				lfo.connect(lfoGain);
				// We can't directly connect lfo to gainNode.gain, but we can simulate the effect 
				// visually or keep it simple. Actually, connecting lfo to gain.gain works:
				lfoGain.connect(gainNode.gain);
				lfo.start();
			}
			
			// Hide overlay and start scrolling
			if (overlay) overlay.style.display = 'none';
			document.body.style.overflow = 'auto'; // allow scroll
		});

		// By default, prevent scroll until audio is started
		document.body.style.overflow = 'hidden';

		// Update audio volume on scroll
		window.addEventListener('scroll', () => {
			if (audioCtx && gainNode) {
				// Calculate scroll percentage
				const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
				let scrollPercent = window.scrollY / scrollHeight;
				
				// Cap max volume so it doesn't get distorted
				const maxVolume = 0.3; 
				const currentGain = Math.min(scrollPercent * maxVolume, maxVolume);
				
				// Smoothly ramp the volume
				gainNode.gain.setTargetAtTime(currentGain, audioCtx.currentTime, 0.1);
			}
		});

		// Modal Logic
		const modal = document.getElementById('ship-modal') as HTMLDialogElement;
		const closeBtn = document.getElementById('close-modal');
		const modalTitle = document.getElementById('modal-title');
		const modalQuote = document.getElementById('modal-quote');

		document.querySelectorAll('.ship-record').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLElement;
				const name = target.getAttribute('data-ship');
				const quote = target.getAttribute('data-quote');
				
				if (modalTitle && name) modalTitle.textContent = name;
				if (modalQuote && quote) modalQuote.textContent = quote;
				
				modal.showModal();
			});
		});

		closeBtn?.addEventListener('click', () => {
			modal.close();
		});

		// Close modal on outside click
		modal?.addEventListener('click', (e) => {
			const dialogDimensions = modal.getBoundingClientRect()
			if (
				e.clientX < dialogDimensions.left ||
				e.clientX > dialogDimensions.right ||
				e.clientY < dialogDimensions.top ||
				e.clientY > dialogDimensions.bottom
			) {
				modal.close();
			}
		});
	});
</script>

<style>
	/* Ocean Background Animation */
	.ocean-container {
		position: relative;
		min-height: 100vh;
		background: #020406;
		overflow-x: hidden;
		color: rgba(255, 255, 255, 0.8);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.wave {
		position: fixed;
		bottom: 0;
		left: 0;
		width: 200%;
		height: 100vh;
		background-repeat: repeat-x;
		transform-origin: center bottom;
		opacity: 0.1;
		z-index: 0;
	}

	.wave1 {
		background-image: radial-gradient(circle at 50% 100%, #1a2a3a 0%, transparent 50%);
		background-size: 50% 100%;
		animation: wave-animation 20s infinite linear;
		opacity: 0.15;
	}

	.wave2 {
		background-image: radial-gradient(circle at 50% 100%, #0a1a2a 0%, transparent 50%);
		background-size: 30% 100%;
		animation: wave-animation 15s infinite linear reverse;
		opacity: 0.2;
		bottom: -10vh;
	}

	.wave3 {
		background-image: radial-gradient(circle at 50% 100%, #05101a 0%, transparent 50%);
		background-size: 20% 100%;
		animation: wave-animation 10s infinite linear;
		opacity: 0.3;
		bottom: -20vh;
	}

	@keyframes wave-animation {
		0% { transform: translateX(0) scaleY(1); }
		50% { transform: translateX(-25%) scaleY(1.1); }
		100% { transform: translateX(-50%) scaleY(1); }
	}

	.overlay {
		position: fixed;
		top: 0; left: 0; right: 0; bottom: 0;
		background: linear-gradient(to bottom, #020406 0%, transparent 40%, #020406 100%);
		z-index: 1;
		pointer-events: none;
	}

	/* Content Styling */
	.voyage-content {
		position: relative;
		z-index: 2;
		max-width: 800px;
		width: 100%;
		padding: var(--space-xl) var(--space-lg);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	/* Audio Overlay */
	.audio-start-overlay {
		position: fixed;
		top: 0; left: 0; right: 0; bottom: 0;
		background: rgba(2, 4, 6, 0.95);
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		backdrop-filter: blur(10px);
	}

	.btn-start-voyage {
		background: transparent;
		color: var(--color-accent);
		border: 1px solid var(--color-accent);
		padding: 1rem 3rem;
		font-size: 1.5rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		cursor: pointer;
		border-radius: 4px;
		margin-bottom: var(--space-md);
		transition: all 1s ease;
		font-family: var(--font-heading);
	}

	.btn-start-voyage:hover {
		background: rgba(196, 167, 125, 0.1);
		box-shadow: 0 0 30px rgba(196, 167, 125, 0.4);
	}

	.audio-start-overlay p {
		color: rgba(255, 255, 255, 0.5);
		font-style: italic;
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--space-xl);
		color: rgba(196, 167, 125, 0.6);
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.voyage-header h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		color: var(--color-accent);
		margin-bottom: var(--space-xs);
		letter-spacing: 2px;
		font-weight: 300;
	}

	.subtitle {
		font-size: 1.2rem;
		font-style: italic;
		color: rgba(255, 255, 255, 0.6);
	}

	.intro-section {
		margin: var(--space-xl) 0 8rem 0;
		max-width: 600px;
	}

	.intro-section p {
		font-size: 1.2rem;
		line-height: 1.8;
		margin-bottom: var(--space-md);
		color: rgba(255, 255, 255, 0.8);
	}

	.ships-container {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 6rem;
		margin-bottom: 8rem;
	}

	.ship-record {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(196, 167, 125, 0.1);
		padding: var(--space-xl);
		border-radius: 4px;
		backdrop-filter: blur(5px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
		width: 100%;
		cursor: pointer;
		text-align: center;
		transition: transform var(--transition-normal), border-color var(--transition-normal);
		font-family: var(--font-body);
	}

	.ship-record:hover {
		transform: translateY(-5px);
		border-color: rgba(196, 167, 125, 0.4);
	}

	.click-hint {
		margin-top: var(--space-lg);
		font-size: 0.8rem;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 1px;
		opacity: 0.5;
	}

	.ship-record:hover .click-hint {
		opacity: 1;
	}

	.ship-record h2 {
		font-size: 2rem;
		color: #fff;
		margin-bottom: var(--space-md);
		font-weight: 300;
	}

	.ship-record h2 em {
		color: var(--color-accent);
		font-style: normal;
	}

	.year {
		display: block;
		font-size: 1.1rem;
		color: rgba(196, 167, 125, 0.8);
		margin-bottom: var(--space-lg);
		text-transform: uppercase;
		letter-spacing: 2px;
	}

	.stats {
		display: flex;
		justify-content: space-around;
		flex-wrap: wrap;
		gap: var(--space-lg);
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.stat .label {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: rgba(255, 255, 255, 0.5);
	}

	.stat .value {
		font-size: 2.5rem;
		font-family: var(--font-heading);
		color: #fff;
	}

	.stat.tragic .value {
		color: #ff4a4a;
		text-shadow: 0 0 10px rgba(255, 74, 74, 0.3);
	}

	.voyage-footer {
		margin-top: 4rem;
		padding-top: 4rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.summary {
		font-size: 1.5rem;
		line-height: 1.6;
		margin-bottom: var(--space-sm);
	}

	.summary strong {
		color: #ff4a4a;
		font-size: 2rem;
	}

	.btn-proceed {
		display: inline-block;
		margin-top: var(--space-xl);
		padding: 1rem 2rem;
		background: transparent;
		color: var(--color-accent);
		border: 1px solid var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 2px;
		font-size: 1rem;
		border-radius: 4px;
		transition: all 1s ease;
	}

	.btn-proceed:hover {
		background: rgba(196, 167, 125, 0.1);
		box-shadow: 0 0 30px rgba(196, 167, 125, 0.2);
	}

	/* Scroll Animations */
	.scrolly-item {
		opacity: 0;
		transform: translateY(40px);
		transition: opacity 1.5s ease-out, transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform;
	}

	.scrolly-item.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Modal Styling */
	.ship-modal {
		background: transparent;
		border: none;
		margin: auto;
		max-width: 600px;
		width: 90%;
	}

	.ship-modal::backdrop {
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(5px);
	}

	.modal-inner {
		background: #f4ecd8; /* Aged paper look */
		color: #2b2520; /* Dark ink */
		padding: var(--space-xl);
		border-radius: 4px;
		position: relative;
		border: 1px solid #d4c5a3;
		box-shadow: inset 0 0 50px rgba(0,0,0,0.1), 0 10px 30px rgba(0,0,0,0.5);
	}

	.close-modal {
		position: absolute;
		top: 10px;
		right: 15px;
		background: transparent;
		border: none;
		font-size: 2rem;
		color: #2b2520;
		cursor: pointer;
		opacity: 0.5;
	}
	
	.close-modal:hover { opacity: 1; }

	#modal-title {
		font-family: var(--font-heading);
		font-size: 2rem;
		margin-bottom: var(--space-md);
		border-bottom: 2px solid rgba(43, 37, 32, 0.2);
		padding-bottom: 0.5rem;
	}

	.modal-body {
		font-family: "Times New Roman", Times, serif;
		font-size: 1.2rem;
		font-style: italic;
		line-height: 1.6;
		margin-bottom: var(--space-lg);
	}

	.modal-footer {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: rgba(43, 37, 32, 0.6);
		text-align: right;
	}
</style>
