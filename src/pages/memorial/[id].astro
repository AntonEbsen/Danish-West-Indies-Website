---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import InteractiveCandle from '../../components/InteractiveCandle.astro';

export async function getStaticPaths() {
  const entries = await getCollection('memorial');
  return entries.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { name, yearOfBirth, yearOfDeath, origin, location, island, plantation, biography, notes, tags, mapLat, mapLng, images, source, relationships, descendantStories, audioRecording, tributes, artifact3d } = entry.data;

// Get related entries (same tags)
const allEntries = await getCollection('memorial');
const relatedEntries = allEntries
  .filter(e => e.id !== entry.id && tags && e.data.tags?.some(t => tags.includes(t)))
  .slice(0, 3);
---

<Layout title={`${name} - Memorial | Danish West Indies`}>
	<article class="profile animate-fade-in">
		<a href="/memorial" class="back-link">← Back to Memorial Register</a>

		<header class="profile-header">
			<InteractiveCandle id={entry.id} name={name} />
			<h1>
				{name}
				<button class="btn-speak" id="btn-speak-name" title="Speak their name" aria-label="Speak name aloud">
					<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
						<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
						<path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
					</svg>
				</button>
			</h1>
			<div class="life-dates">
				{yearOfBirth && <span>Born ~{yearOfBirth}</span>}
				{yearOfBirth && yearOfDeath && <span class="separator">—</span>}
				{yearOfDeath && <span>Died ~{yearOfDeath}</span>}
			</div>
			{audioRecording && (
				<div class="audio-player">
					<p class="audio-label">Say Their Name:</p>
					<audio controls src={audioRecording}></audio>
				</div>
			)}
		</header>

		<div class="profile-body">
			<aside class="profile-details">
				<h3>Details</h3>
				<dl>
					{origin && (
						<>
							<dt>Origin</dt>
							<dd>{origin}</dd>
						</>
					)}
					{island && (
						<>
							<dt>Island</dt>
							<dd>{island}</dd>
						</>
					)}
					{plantation && (
						<>
							<dt>Plantation</dt>
							<dd>{plantation}</dd>
						</>
					)}
					{location && (
						<>
							<dt>Location</dt>
							<dd>{location}</dd>
						</>
					)}
					{source && (
						<>
							<dt>Source</dt>
							<dd class="source-attr">{source}</dd>
						</>
					)}
				</dl>

				<div class="citation-tool">
					<h3>Cite this Page</h3>
					<button id="cite-btn" class="btn-cite" data-name={name} data-url={`https://danishwestindies.org/memorial/${entry.id}`}>
						Copy Citation
					</button>
					<span id="cite-msg" class="cite-msg" style="display: none;">Copied!</span>
				</div>

				{tags && tags.length > 0 && (
					<div class="profile-tags">
						<h3>Connected Events</h3>
						<div class="tag-list">
							{tags.map(tag => (
								<span class="tag">{tag}</span>
							))}
						</div>
					</div>
				)}

				{relationships && relationships.length > 0 && (
					<div class="profile-relationships">
						<h3>Family & Relations</h3>
						<ul class="relationship-list">
							{relationships.map(rel => (
								<li>
									<a href={`/memorial/${rel.id}`} class="rel-link">{rel.id.replace(/-/g, ' ')}</a>
									<span class="rel-type">({rel.type})</span>
								</li>
							))}
						</ul>
					</div>
				)}
			</aside>

			<div class="profile-content">
				{biography && (
					<section class="bio-section">
						<h2>Their Story</h2>
						<p class="biography">{biography}</p>
					</section>
				)}

				{notes && !biography && (
					<section class="bio-section">
						<h2>About</h2>
						<p class="biography">{notes}</p>
					</section>
				)}

				{relationships && relationships.length > 0 && (
					<section class="tree-section">
						<h2>Family & Connections Tree</h2>
						<div id="family-tree-container" class="tree-container"></div>
						<script define:vars={{ name, id: entry.id, relationships }}>
							document.addEventListener("DOMContentLoaded", () => {
								if (typeof vis === 'undefined') return;
								
								const nodes = [
									{ id: id, label: name, group: 'center', level: 0 }
								];
								const edges = [];
								
								relationships.forEach(rel => {
									nodes.push({ id: rel.id, label: rel.id.replace(/-/g, ' '), group: 'relation', level: 1 });
									edges.push({ from: id, to: rel.id, label: rel.type });
								});
								
								const container = document.getElementById('family-tree-container');
								const data = { nodes, edges };
								const options = {
									layout: {
										hierarchical: {
											direction: 'UD',
											sortMethod: 'directed',
											levelSeparation: 100,
											nodeSpacing: 150
										}
									},
									nodes: {
										shape: 'box',
										font: { color: '#c4a77d', face: 'Lora, serif', size: 14 },
										borderWidth: 2,
										margin: 10
									},
									edges: {
										font: { color: '#a0a09b', size: 12, align: 'middle' },
										color: { color: '#555' },
										arrows: 'to'
									},
									groups: {
										center: { color: { background: '#111', border: '#c4a77d' } },
										relation: { color: { background: '#1a2a3a', border: '#4a6a8a' } }
									},
									interaction: { dragNodes: false }
								};
								new vis.Network(container, data, options);
							});
						</script>
					</section>
				)}

				{descendantStories && descendantStories.length > 0 && (
					<section class="stories-section">
						<h2>Descendant Testimonies</h2>
						<div class="stories-list">
							{descendantStories.map(story => (
								<div class="story-wrapper">
									{story.mediaUrl && (
										<div class="media-container">
											<iframe src={story.mediaUrl} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
										</div>
									)}
									<blockquote class="descendant-story">
										<p>"{story.text}"</p>
										<footer>— {story.author}</footer>
									</blockquote>
								</div>
							))}
						</div>
					</section>
				)}

				{tags && (tags.includes('1848 Uprising') || tags.includes('Sugar Cultivation')) && (
					<section class="context-section">
						<h2>Historical Context</h2>
						{tags.includes('1848 Uprising') && (
							<div class="context-panel">
								<h3>The 1848 Uprising</h3>
								<p>In July 1848, thousands of enslaved people marched on Frederiksted, St. Croix, demanding immediate emancipation. Led by figures like General Buddhoe, this mass mobilization forced Governor Peter von Scholten to declare emancipation, effectively ending slavery in the Danish West Indies.</p>
							</div>
						)}
						{tags.includes('Sugar Cultivation') && (
							<div class="context-panel">
								<h3>Sugar Cultivation</h3>
								<p>The economy of the Danish West Indies was heavily dependent on sugar cane production. Enslaved people endured grueling, back-breaking labor in the fields and dangerous conditions in the boiling houses to produce sugar and rum for European markets.</p>
							</div>
						)}
					</section>
				)}

				{artifact3d && (
					<section class="artifact-section">
						<h2>Historical Artifact</h2>
						<div class="model-container">
							<model-viewer 
								src={artifact3d} 
								alt={`3D model related to ${name}`} 
								auto-rotate 
								camera-controls 
								shadow-intensity="1"
								class="model-viewer-element">
							</model-viewer>
						</div>
					</section>
				)}

				{tributes && tributes.length > 0 && (
					<section class="tributes-section">
						<h2>Community Tributes</h2>
						<div class="tributes-list">
							{tributes.map(tribute => (
								<div class="tribute-card">
									<p>"{tribute.text}"</p>
									<footer>— {tribute.author}</footer>
								</div>
							))}
						</div>
						<div class="leave-tribute-cta">
							<a href={`mailto:curator@danishwestindies.org?subject=Tribute for ${name}`} class="btn-secondary">Leave a Tribute</a>
						</div>
					</section>
				)}

				{images && images.length > 0 && (
					<section class="gallery-section">
						<h2>Archival Records</h2>
						<div class="gallery-grid">
							{images.map(img => (
								<figure class="gallery-item">
									<img src={img} alt={`Archival record for ${name}`} loading="lazy" />
								</figure>
							))}
						</div>
					</section>
				)}

				{mapLat && mapLng && island && (
					<section class="location-section">
						<h2>Location</h2>
						<div class="mini-map">
							<svg viewBox="0 0 400 250" class="mini-map-svg">
								<rect width="400" height="250" fill="#0a1628" rx="6"/>
								{island === "St. Croix" && (
									<g>
										<path d="M100,100 Q140,70 200,65 Q260,70 310,85 Q330,100 325,120 Q310,140 260,145 Q200,148 150,135 Q115,125 100,100Z" 
											fill="#1a3a2a" stroke="#c4a77d" stroke-width="1.5"/>
										<circle cx={200} cy={110} r="6" fill="#c4a77d"/>
										<circle cx={200} cy={110} r="10" fill="none" stroke="#c4a77d" stroke-width="1" opacity="0.4" class="pin-pulse"/>
										<text x="200" y="170" text-anchor="middle" fill="#c4a77d" font-size="14" font-family="Lora, serif">{island}</text>
									</g>
								)}
								{island === "St. Thomas" && (
									<g>
										<path d="M130,100 Q160,80 200,85 Q230,90 245,105 Q240,120 220,130 Q190,135 160,125 Q135,115 130,100Z" 
											fill="#1a3a2a" stroke="#c4a77d" stroke-width="1.5"/>
										<circle cx={190} cy={105} r="6" fill="#c4a77d"/>
										<circle cx={190} cy={105} r="10" fill="none" stroke="#c4a77d" stroke-width="1" opacity="0.4" class="pin-pulse"/>
										<text x="190" y="160" text-anchor="middle" fill="#c4a77d" font-size="14" font-family="Lora, serif">{island}</text>
									</g>
								)}
								{island === "St. John" && (
									<g>
										<path d="M150,100 Q175,82 210,87 Q235,95 240,112 Q235,128 210,133 Q185,138 165,128 Q148,115 150,100Z" 
											fill="#1a3a2a" stroke="#c4a77d" stroke-width="1.5"/>
										<circle cx={195} cy={108} r="6" fill="#c4a77d"/>
										<circle cx={195} cy={108} r="10" fill="none" stroke="#c4a77d" stroke-width="1" opacity="0.4" class="pin-pulse"/>
										<text x="195" y="160" text-anchor="middle" fill="#c4a77d" font-size="14" font-family="Lora, serif">{island}</text>
									</g>
								)}
							</svg>
						</div>
					</section>
				)}
			</div>
		</div>

		{relatedEntries.length > 0 && (
			<section class="related-section">
				<h2>Connected Lives</h2>
				<p class="related-intro">Other individuals connected through shared events and resistance.</p>
				<div class="related-grid">
					{relatedEntries.map(related => (
						<a href={`/memorial/${related.id}`} class="related-card">
							<h3>{related.data.name}</h3>
							{related.data.notes && <p>{related.data.notes}</p>}
						</a>
					))}
				</div>
			</section>
		)}
	</article>
</Layout>

<script define:vars={{ name }}>
	const citeBtn = document.getElementById('cite-btn');
	const citeMsg = document.getElementById('cite-msg');

	if (citeBtn && citeMsg) {
		citeBtn.addEventListener('click', async () => {
			const btnName = citeBtn.getAttribute('data-name');
			const url = citeBtn.getAttribute('data-url');
			const date = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
			
			// Chicago style citation
			const citation = `"${btnName}," The Memorial Register, Danish West Indies Website, accessed ${date}, ${url}.`;
			
			try {
				await navigator.clipboard.writeText(citation);
				citeMsg.style.display = 'inline-block';
				setTimeout(() => {
					citeMsg.style.display = 'none';
				}, 2000);
			} catch (err) {
				console.error('Failed to copy citation', err);
			}
		});
	}

	// Speak Name functionality
	const speakBtn = document.getElementById('btn-speak-name');
	if (speakBtn && 'speechSynthesis' in window) {
		speakBtn.addEventListener('click', () => {
			const utterance = new SpeechSynthesisUtterance(name);
			// Try to pick a voice that might sound appropriate if possible
			utterance.lang = 'en-US'; 
			utterance.rate = 0.9;
			utterance.pitch = 0.9;
			window.speechSynthesis.speak(utterance);
		});
	} else if (speakBtn) {
		speakBtn.style.display = 'none';
	}
</script>

{relationships && relationships.length > 0 && (
	<script src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js" is:inline></script>
)}

{artifact3d && (
	<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.1.1/model-viewer.min.js"></script>
)}

<style>
	.back-link {
		display: inline-block;
		margin-bottom: var(--space-lg);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.profile-header {
		text-align: center;
		padding-bottom: var(--space-lg);
		margin-bottom: var(--space-lg);
		border-bottom: 1px solid var(--color-border);
	}

	.candle-icon {
		font-size: 2.5rem;
		margin-bottom: var(--space-sm);
		animation: flicker 3s ease-in-out infinite alternate;
	}

	@keyframes flicker {
		0%, 100% { opacity: 0.7; }
		25% { opacity: 0.8; }
		50% { opacity: 0.6; }
		75% { opacity: 0.9; }
	}

	.profile-header h1 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		margin-bottom: var(--space-xs);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.btn-speak {
		background: none;
		border: none;
		color: var(--color-accent);
		cursor: pointer;
		opacity: 0.7;
		transition: all var(--transition-fast);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		width: 40px;
		height: 40px;
	}

	.btn-speak:hover {
		opacity: 1;
		background: rgba(196, 167, 125, 0.1);
		transform: scale(1.1);
	}

	.life-dates {
		font-size: 1.1rem;
		color: var(--color-text-muted);
		font-family: var(--font-heading);
		font-style: italic;
	}

	.separator {
		margin: 0 0.5rem;
	}

	.profile-body {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: var(--space-lg);
		margin-bottom: var(--space-xl);
	}

	/* Sidebar */
	.profile-details {
		position: sticky;
		top: var(--space-md);
		align-self: start;
	}

	.profile-details h3 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	dl {
		margin-bottom: var(--space-md);
	}

	dt {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--color-text-muted);
		margin-bottom: 0.15rem;
	}

	dd {
		font-size: 1rem;
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}

	.source-attr {
		font-size: 0.85rem;
		font-style: italic;
		color: var(--color-text-muted);
	}

	.citation-tool {
		margin-bottom: var(--space-md);
		padding: var(--space-sm) 0;
		border-top: 1px solid var(--color-border);
	}

	.citation-tool h3 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.btn-cite {
		background: transparent;
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
		padding: 0.4rem 0.8rem;
		border-radius: 4px;
		cursor: pointer;
		font-size: 0.85rem;
		font-family: var(--font-body);
		transition: all var(--transition-fast);
	}

	.btn-cite:hover {
		background: rgba(196, 167, 125, 0.1);
	}

	.cite-msg {
		font-size: 0.85rem;
		color: #4ade80;
		margin-left: 0.5rem;
	}

	.profile-tags, .profile-relationships {
		padding-top: var(--space-md);
		border-top: 1px solid var(--color-border);
		margin-bottom: var(--space-md);
	}

	.profile-relationships h3 {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		margin-bottom: var(--space-sm);
	}

	.relationship-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.relationship-list li {
		margin-bottom: 0.4rem;
	}

	.rel-link {
		color: var(--color-text);
		text-decoration: none;
		border-bottom: 1px dotted var(--color-accent);
		text-transform: capitalize;
	}

	.rel-link:hover {
		color: var(--color-accent);
	}

	.rel-type {
		font-size: 0.8rem;
		color: var(--color-text-muted);
		margin-left: 0.3rem;
	}

	.audio-player {
		margin-top: var(--space-md);
		display: inline-block;
	}

	.audio-label {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--color-text-muted);
		margin-bottom: 0.4rem;
	}

	audio {
		height: 36px;
		border-radius: 4px;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		display: inline-block;
		padding: 0.25rem 0.7rem;
		background: rgba(196, 167, 125, 0.12);
		color: var(--color-accent);
		border: 1px solid rgba(196, 167, 125, 0.25);
		border-radius: 3px;
		font-size: 0.8rem;
		font-weight: 500;
	}

	/* Main content */
	.bio-section h2, .location-section h2 {
		font-size: 1.3rem;
		margin-bottom: var(--space-md);
		color: var(--color-accent);
	}

	.biography {
		font-size: 1.05rem;
		line-height: 1.9;
		color: var(--color-text);
	}

	.stories-section, .context-section, .location-section, .gallery-section, .artifact-section, .tributes-section, .tree-section {
		margin-top: var(--space-lg);
	}

	.stories-section h2, .context-section h2, .artifact-section h2, .tributes-section h2, .tree-section h2 {
		font-size: 1.3rem;
		margin-bottom: var(--space-md);
		color: var(--color-accent);
	}

	.descendant-story {
		background: rgba(196, 167, 125, 0.05);
		border-left: 3px solid var(--color-accent);
		padding: var(--space-md);
		margin: 0 0 var(--space-md) 0;
		border-radius: 0 6px 6px 0;
	}

	.media-container {
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-bottom: var(--space-sm);
		border-radius: 6px;
		overflow: hidden;
	}
	
	.media-container iframe {
		width: 100%;
		height: 100%;
		border: none;
	}

	.descendant-story p {
		font-size: 1.05rem;
		font-style: italic;
		line-height: 1.7;
		margin-bottom: var(--space-sm);
	}

	.descendant-story footer {
		font-size: 0.9rem;
		color: var(--color-accent);
		font-weight: 600;
	}

	.context-panel {
		background: var(--color-bg-light);
		border: 1px solid var(--color-border);
		padding: var(--space-md);
		border-radius: 6px;
		margin-bottom: var(--space-md);
	}

	.context-panel h3 {
		font-size: 1.1rem;
		color: var(--color-text);
		margin-bottom: var(--space-xs);
	}

	.context-panel p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--color-text-muted);
		margin: 0;
	}

	.tree-container {
		width: 100%;
		height: 350px;
		background: var(--color-bg-light);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		overflow: hidden;
	}

	.model-container {
		width: 100%;
		height: 400px;
		background: var(--color-bg-light);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		overflow: hidden;
	}

	.model-viewer-element {
		width: 100%;
		height: 100%;
		--poster-color: transparent;
	}

	.tributes-list {
		display: grid;
		gap: var(--space-md);
		margin-bottom: var(--space-md);
	}

	.tribute-card {
		background: rgba(196, 167, 125, 0.05);
		border: 1px solid rgba(196, 167, 125, 0.2);
		border-radius: 6px;
		padding: var(--space-md);
	}

	.tribute-card p {
		font-size: 1.05rem;
		font-style: italic;
		line-height: 1.7;
		margin-bottom: var(--space-sm);
	}

