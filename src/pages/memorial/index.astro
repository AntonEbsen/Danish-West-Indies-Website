---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AmbientSound from '../../components/AmbientSound.astro';
import OnThisDay from '../../components/OnThisDay.astro';

// Fetch all memorial entries from the collection
const memorialEntries = await getCollection('memorial');

// Sort by name alphabetically
memorialEntries.sort((a, b) => a.data.name.localeCompare(b.data.name));

// Get unique islands and tags for filters
const islands = [...new Set(memorialEntries.map(e => e.data.island).filter(Boolean))];
const allTags = [...new Set(memorialEntries.flatMap(e => e.data.tags || []))].sort();

// Pick a "Name of the Day" based on day of year
const dayOfYear = Math.floor((Date.now() - new Date(new Date().getFullYear(), 0, 0).getTime()) / 86400000);
const spotlightEntry = memorialEntries.length > 0 ? memorialEntries[dayOfYear % memorialEntries.length] : null;

// Prepare entries as JSON for client-side filtering
const entriesData = memorialEntries.map(e => ({
  id: e.id,
  ...e.data,
}));
---

<Layout title="Memorial Register - Names & Lives | Danish West Indies">
	<!-- Spotlight: Name of the Day -->
	{spotlightEntry && (
		<section class="spotlight animate-fade-in">
			<div class="spotlight-inner">
				<span class="spotlight-label">✦ Remembering Today ✦</span>
				<h2 class="spotlight-name">{spotlightEntry.data.name}</h2>
				{spotlightEntry.data.notes && <p class="spotlight-notes">{spotlightEntry.data.notes}</p>}
				<a href={`/memorial/${spotlightEntry.id}`} class="spotlight-link">Read their story →</a>
			</div>
		</section>
	)}

	<OnThisDay />

	<div class="page-header animate-fade-in" style="animation-delay: 0.15s;">
		<h1>The Memorial Register</h1>
		<p class="subtitle">Honoring the names, lives, and humanity of those who were enslaved.</p>
		<div class="counter">
			<span class="counter-number">{memorialEntries.length}</span>
			<span class="counter-text">individuals remembered</span>
		</div>
	</div>
	
	<section class="memorial-section animate-fade-in" style="animation-delay: 0.25s;">
		<p class="intro-text">
			Below is a growing record of individuals who lived and suffered under slavery in the Danish West Indies. 
			By recording their names, we acknowledge their existence, their resilience, and the injustice they endured.
		</p>

		<!-- Search and Filters -->
		<div class="memorial-controls">
			<div class="search-bar">
				<input type="text" id="search-input" placeholder="Search by name, origin, location, or use tags (e.g., island:St.Croix)..." aria-label="Search the memorial register">
				<svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</div>
			<div class="filter-group">
				<select id="filter-island" aria-label="Filter by Island">
					<option value="">All Islands</option>
					<option value="St. Croix">St. Croix</option>
					<option value="St. Thomas">St. Thomas</option>
					<option value="St. John">St. John</option>
				</select>
				
				<select id="filter-tag" aria-label="Filter by Event/Tag">
					<option value="">All Events</option>
					<option value="1848 Uprising">1848 Uprising</option>
					<option value="1733 Rebellion">1733 Rebellion</option>
					<option value="1878 Fireburn">1878 Fireburn</option>
					<option value="Sugar Cultivation">Sugar Cultivation</option>
				</select>

				<a href="/api/dataset.csv" class="btn-download" title="Download Register Data (CSV)">
					<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
						<polyline points="7 10 12 15 17 10"></polyline>
						<line x1="12" y1="15" x2="12" y2="3"></line>
					</svg>
				</a>
			</div>
			<p class="results-count" id="results-count">{memorialEntries.length} individuals recorded</p>
		</div>

		<!-- Interactive Map -->
		<div class="map-section">
			<h2 class="section-heading">Map of the Danish West Indies</h2>
			<div class="map-container" id="dwi-map">
				<svg viewBox="0 0 800 500" class="map-svg">
					<!-- Ocean background -->
					<rect width="800" height="500" fill="#0a1628" rx="8"/>
					
					<!-- Water texture lines -->
					<g stroke="#132040" stroke-width="0.5" opacity="0.5">
						<line x1="0" y1="50" x2="800" y2="55"/>
						<line x1="0" y1="100" x2="800" y2="108"/>
						<line x1="0" y1="150" x2="800" y2="145"/>
						<line x1="0" y1="200" x2="800" y2="210"/>
						<line x1="0" y1="250" x2="800" y2="248"/>
						<line x1="0" y1="300" x2="800" y2="305"/>
						<line x1="0" y1="350" x2="800" y2="345"/>
						<line x1="0" y1="400" x2="800" y2="410"/>
						<line x1="0" y1="450" x2="800" y2="448"/>
					</g>

					<!-- St. Thomas -->
					<g class="island-group" data-island="St. Thomas">
						<path d="M180,180 Q200,160 240,165 Q260,170 270,185 Q265,200 245,210 Q220,215 200,205 Q185,195 180,180Z" 
							fill="#1a3a2a" stroke="#c4a77d" stroke-width="1.5" class="island-path"/>
						<text x="225" y="240" text-anchor="middle" fill="#c4a77d" font-size="14" font-family="Lora, serif">St. Thomas</text>
						<text x="225" y="256" text-anchor="middle" fill="#a0a09b" font-size="10" font-family="Inter, sans-serif">Charlotte Amalie</text>
					</g>
					
					<!-- St. John -->
					<g class="island-group" data-island="St. John">
						<path d="M340,170 Q360,155 390,160 Q410,168 415,185 Q410,200 390,205 Q365,210 350,200 Q338,188 340,170Z" 
							fill="#1a3a2a" stroke="#c4a77d" stroke-width="1.5" class="island-path"/>
						<text x="377" y="230" text-anchor="middle" fill="#c4a77d" font-size="14" font-family="Lora, serif">St. John</text>
						<text x="377" y="246" text-anchor="middle" fill="#a0a09b" font-size="10" font-family="Inter, sans-serif">Cruz Bay</text>
					</g>
					
					<!-- St. Croix (larger, further south) -->
					<g class="island-group" data-island="St. Croix">
						<path d="M350,340 Q390,310 450,305 Q510,310 560,325 Q580,340 575,360 Q560,380 510,385 Q450,388 400,375 Q365,365 350,340Z" 
							fill="#1a3a2a" stroke="#c4a77d" stroke-width="1.5" class="island-path"/>
						<text x="465" y="415" text-anchor="middle" fill="#c4a77d" font-size="14" font-family="Lora, serif">St. Croix</text>
						<text x="420" y="365" text-anchor="middle" fill="#a0a09b" font-size="10" font-family="Inter, sans-serif">Frederiksted</text>
						<text x="530" y="350" text-anchor="middle" fill="#a0a09b" font-size="10" font-family="Inter, sans-serif">Christiansted</text>
					</g>

					<!-- Compass Rose -->
					<g transform="translate(700, 80)">
						<circle r="25" fill="none" stroke="#333" stroke-width="1"/>
						<line x1="0" y1="-20" x2="0" y2="20" stroke="#c4a77d" stroke-width="1"/>
						<line x1="-20" y1="0" x2="20" y2="0" stroke="#c4a77d" stroke-width="1"/>
						<text x="0" y="-28" text-anchor="middle" fill="#c4a77d" font-size="12" font-family="Lora, serif">N</text>
					</g>

					<!-- Map Pins for entries -->
					{memorialEntries.filter(e => e.data.mapLat && e.data.mapLng).map(entry => {
						// Map real coordinates to SVG space (approximate)
						let svgX, svgY;
						if (entry.data.island === "St. Thomas") {
							svgX = 225; svgY = 185;
						} else if (entry.data.island === "St. John") {
							svgX = 377; svgY = 180;
						} else {
							// St. Croix - spread pins across the island
							svgX = 400 + ((entry.data.mapLng! + 64.88) * 800);
							svgY = 345 + ((entry.data.mapLat! - 17.73) * 200);
						}
						return (
							<g class="map-pin" data-name={entry.data.name} data-id={entry.id}>
								<circle cx={svgX} cy={svgY} r="6" fill="#c4a77d" opacity="0.9" class="pin-dot"/>
								<circle cx={svgX} cy={svgY} r="10" fill="none" stroke="#c4a77d" stroke-width="1" opacity="0.4" class="pin-pulse"/>
							</g>
						);
					})}

					<!-- Title cartouche -->
					<g transform="translate(80, 420)">
						<rect x="-60" y="-20" width="200" height="50" rx="4" fill="#111" stroke="#333" stroke-width="1" opacity="0.8"/>
						<text x="40" y="2" text-anchor="middle" fill="#c4a77d" font-size="13" font-family="Lora, serif">Danish West Indies</text>
						<text x="40" y="18" text-anchor="middle" fill="#a0a09b" font-size="9" font-family="Inter, sans-serif">Caribbean Sea, 1672–1917</text>
					</g>
				</svg>
			</div>
		</div>

		<!-- Memorial Grid -->
		<div class="memorial-grid" id="memorial-grid">
			{memorialEntries.map((entry, index) => (
				<a href={`/memorial/${entry.id}`} class="memorial-card scroll-animate" 
					data-name={entry.data.name.toLowerCase()}
					data-origin={(entry.data.origin || '').toLowerCase()}
					data-location={(entry.data.location || '').toLowerCase()}
					data-island={entry.data.island || ''}
					data-tags={(entry.data.tags || []).join(',')}
					style="display: none;">
					<div class="card-candle" aria-hidden="true">🕯</div>
					<h3 class="name">{entry.data.name}</h3>
					<div class="details">
						{entry.data.yearOfBirth && <p><strong>Born:</strong> ~{entry.data.yearOfBirth}</p>}
						{entry.data.yearOfDeath && <p><strong>Died:</strong> ~{entry.data.yearOfDeath}</p>}
						{entry.data.origin && <p><strong>Origin:</strong> {entry.data.origin}</p>}
						{entry.data.location && <p><strong>Location:</strong> {entry.data.location}</p>}
					</div>
					{entry.data.tags && entry.data.tags.length > 0 && (
						<div class="tag-list">
							{entry.data.tags.map(tag => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)}
					{entry.data.notes && <p class="notes">{entry.data.notes}</p>}
					<span class="read-more">Read their story →</span>
				</a>
			))}
			
			{memorialEntries.length === 0 && (
				<p class="empty-state">The register is currently being compiled.</p>
			)}
		</div>

		<div class="load-more-container" id="load-more-container" style="display: none;">
			<button id="load-more-btn" class="btn-primary">Load More Names</button>
		</div>

		<p class="no-results" id="no-results" style="display: none;">No individuals found matching your search.</p>

		<!-- Submit a Name Section -->
		<div class="submit-name-section scroll-animate">
			<h2>Help Grow the Register</h2>
			<p>If you have archival records, family histories, or information about an enslaved individual in the Danish West Indies, please help us honor them by submitting their name to the register.</p>
			<a href="mailto:submit@danishwestindies.org?subject=Memorial Register Submission" class="btn-secondary">Submit a Name</a>
		</div>
	</section>

	<AmbientSound />
</Layout>

<script>
	// Client-side search and filtering
	const searchInput = document.getElementById('memorial-search') as HTMLInputElement;
	const filterIsland = document.getElementById('filter-island') as HTMLSelectElement;
	const filterTag = document.getElementById('filter-tag') as HTMLSelectElement;
	const grid = document.getElementById('memorial-grid')!;
	const cards = Array.from(grid.querySelectorAll('.memorial-card')) as HTMLElement[];
	const resultsCount = document.getElementById('results-count')!;
	const noResults = document.getElementById('no-results')!;
	const loadMoreBtn = document.getElementById('load-more-btn')!;
	const loadMoreContainer = document.getElementById('load-more-container')!;
	
	const ITEMS_PER_PAGE = 24;
	let currentPage = 1;
	let visibleCards: HTMLElement[] = [];

	function renderPagination() {
		const startIndex = 0;
		const endIndex = currentPage * ITEMS_PER_PAGE;
		
		visibleCards.forEach((card, index) => {
			if (index >= startIndex && index < endIndex) {
				card.style.display = 'block';
				// Slight delay for new cards
				if (index >= (currentPage - 1) * ITEMS_PER_PAGE) {
					card.style.animationDelay = `${(index % ITEMS_PER_PAGE) * 0.05}s`;
				}
			} else {
				card.style.display = 'none';
			}
		});

		if (endIndex < visibleCards.length) {
			loadMoreContainer.style.display = 'block';
		} else {
			loadMoreContainer.style.display = 'none';
		}
	}

	function filterCards() {
		const rawQuery = searchInput.value.toLowerCase().trim();
		const island = filterIsland.value;
		const tag = filterTag.value;
		
		visibleCards = [];

		// Parse advanced search (e.g. island:"St. Croix" year:>1800)
		// A simple implementation: extract key:value pairs and a base query
		let baseQuery = rawQuery;
		const searchCriteria: Record<string, string> = {};
		
		const matches = rawQuery.match(/(\w+):"([^"]+)"|(\w+):([^\s]+)/g);
		if (matches) {
			matches.forEach(match => {
				const parts = match.split(':');
				if (parts.length >= 2) {
					const key = parts[0].trim();
					const val = parts.slice(1).join(':').replace(/"/g, '').trim();
					searchCriteria[key] = val;
					baseQuery = baseQuery.replace(match, '');
				}
			});
		}
		baseQuery = baseQuery.trim();

		cards.forEach(card => {
			const name = card.dataset.name || '';
			const origin = card.dataset.origin || '';
			const location = card.dataset.location || '';
			const cardIsland = card.dataset.island || '';
			const cardTags = (card.dataset.tags || '').toLowerCase();

			let matchesSearch = true;

			// Handle base query
			if (baseQuery) {
				matchesSearch = name.includes(baseQuery) || origin.includes(baseQuery) || location.includes(baseQuery);
			}

			// Handle advanced criteria
			for (const [key, val] of Object.entries(searchCriteria)) {
				if (key === 'island') {
					if (!cardIsland.toLowerCase().includes(val)) matchesSearch = false;
				} else if (key === 'origin') {
					if (!origin.includes(val)) matchesSearch = false;
				} else if (key === 'tag' || key === 'event') {
					if (!cardTags.includes(val)) matchesSearch = false;
				}
			}

			const matchesIsland = !island || cardIsland === island;
			const matchesTag = !tag || (card.dataset.tags || '').split(',').includes(tag);

			if (matchesSearch && matchesIsland && matchesTag) {
				visibleCards.push(card);
			} else {
				card.style.display = 'none';
			}
		});

		currentPage = 1;
		renderPagination();

		resultsCount.textContent = `${visibleCards.length} individual${visibleCards.length !== 1 ? 's' : ''} found`;
		noResults.style.display = visibleCards.length === 0 ? 'block' : 'none';
	}

	loadMoreBtn.addEventListener('click', () => {
		currentPage++;
		renderPagination();
	});

	searchInput.addEventListener('input', filterCards);
	filterIsland.addEventListener('change', filterCards);
	filterTag.addEventListener('change', filterCards);

	// Initial render
	filterCards();

	// Intersection Observer for scroll animations
	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.1 });

	document.querySelectorAll('.scroll-animate').forEach(el => {
		observer.observe(el);
	});

	// Map pin hover interactions
	const pins = document.querySelectorAll('.map-pin');
	pins.forEach(pin => {
		pin.addEventListener('mouseenter', () => {
			const id = (pin as HTMLElement).dataset.id;
			if (id) {
				const card = grid.querySelector(`[href="/memorial/${id}"]`) as HTMLElement;
				if (card) {
					card.style.borderLeftColor = '#d8c09a';
					card.style.boxShadow = '0 10px 20px rgba(196, 167, 125, 0.15)';
				}
			}
		});
		pin.addEventListener('mouseleave', () => {
			const id = (pin as HTMLElement).dataset.id;
			if (id) {
				const card = grid.querySelector(`[href="/memorial/${id}"]`) as HTMLElement;
				if (card) {
					card.style.borderLeftColor = '';
					card.style.boxShadow = '';
				}
			}
		});
		pin.addEventListener('click', () => {
			const id = (pin as HTMLElement).dataset.id;
			if (id) {
				window.location.href = `/memorial/${id}`;
			}
		});
	});
</script>

<style>
	/* Spotlight Section */
	.spotlight {
		text-align: center;
		padding: var(--space-lg) var(--space-md);
		margin-bottom: var(--space-lg);
		background: linear-gradient(180deg, rgba(196,167,125,0.08) 0%, transparent 100%);
		border-bottom: 1px solid var(--color-border);
	}

	.spotlight-inner {
		max-width: 700px;
		margin: 0 auto;
	}

	.spotlight-label {
		display: block;
		font-size: 0.85rem;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 3px;
		margin-bottom: var(--space-sm);
		font-weight: 500;
	}

	.spotlight-name {
		font-size: clamp(2rem, 4vw, 3rem);
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}

	.spotlight-notes {
		color: var(--color-text-muted);
		font-style: italic;
		font-family: var(--font-heading);
		line-height: 1.8;
		margin-bottom: var(--space-md);
	}

	.spotlight-link {
		display: inline-block;
		color: var(--color-accent);
		font-weight: 500;
		font-size: 0.95rem;
		transition: color var(--transition-fast);
	}

	.spotlight-link:hover {
		color: var(--color-accent-hover);
	}

	/* Page Header */
	.page-header {
		margin-bottom: var(--space-xl);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-lg);
		text-align: center;
	}
	
	.page-header h1 {
		font-size: clamp(2.5rem, 6vw, 5rem);
		color: var(--color-text);
		margin-bottom: var(--space-xs);
	}
	
	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-muted);
		font-style: italic;
		font-family: var(--font-heading);
		margin-bottom: var(--space-md);
	}

	.counter {
		display: inline-block;
		background: rgba(196, 167, 125, 0.1);
		border: 1px solid rgba(196, 167, 125, 0.3);
		padding: 0.5rem 1.5rem;
		border-radius: 30px;
	}

	.counter-number {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-accent);
		margin-right: 0.5rem;
	}

	.counter-text {
		font-size: 1rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.intro-text {
		max-width: 800px;
		margin: 0 auto var(--space-xl);
		text-align: center;
		font-size: 1.1rem;
		line-height: 1.8;
	}

	/* Filters */
	.filters-bar {
		max-width: 800px;
		margin: 0 auto var(--space-lg);
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.search-wrapper {
		position: relative;
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--color-text-muted);
	}

	#memorial-search {
		width: 100%;
		padding: 0.9rem 1rem 0.9rem 2.8rem;
		background: var(--color-bg-light);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 1rem;
		transition: border-color var(--transition-fast);
	}

	#memorial-search:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	#memorial-search::placeholder {
		color: var(--color-text-muted);
	}

	.filter-group {
		display: flex;
		gap: var(--space-sm);
	}

	.filter-group select {
		flex: 1;
		padding: 0.7rem 1rem;
		background: var(--color-bg-light);
		border: 1px solid var(--color-border);
		border-radius: 6px;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 0.9rem;
		cursor: pointer;
		transition: border-color var(--transition-fast);
	}

	.filter-group select:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.results-count {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		text-align: center;
		margin-bottom: 0;
	}

	/* Map */
	.map-section {
		margin-bottom: var(--space-xl);
	}

	.section-heading {
		text-align: center;
		margin-bottom: var(--space-md);
		font-size: 1.5rem;
	}

	.map-container {
		max-width: 800px;
		margin: 0 auto;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		overflow: hidden;
	}

	.map-svg {
		width: 100%;
		height: auto;
		display: block;
	}

	.island-path {
		transition: fill var(--transition-fast), stroke-width var(--transition-fast);
	}

	.island-group:hover .island-path {
		fill: #243d2e;
		stroke-width: 2.5;
	}

	.map-pin {
		cursor: pointer;
	}

	.pin-dot {
		transition: r var(--transition-fast), fill var(--transition-fast);
	}

	.map-pin:hover .pin-dot {
		r: 8;
		fill: #d8c09a;
	}

	@keyframes pulse {
		0% { r: 10; opacity: 0.4; }
		100% { r: 18; opacity: 0; }
	}

	.pin-pulse {
		animation: pulse 2s ease-out infinite;
	}

	/* Memorial Grid */
	.memorial-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: var(--space-md);
		padding-bottom: var(--space-md);
	}

	.scroll-animate {
