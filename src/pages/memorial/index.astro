---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Fetch all memorial entries from the collection
const memorialEntries = await getCollection('memorial');

// Sort by name alphabetically
memorialEntries.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout title="Memorial Register - Danish West Indies">
	<div class="page-header animate-fade-in">
		<h1>The Memorial Register</h1>
		<p class="subtitle">Honoring the names, lives, and humanity of those who were enslaved.</p>
	</div>
	
	<section class="memorial-section animate-fade-in" style="animation-delay: 0.2s;">
		<p class="intro-text">
			Below is a growing record of individuals who lived and suffered under slavery in the Danish West Indies. 
			By recording their names, we acknowledge their existence, their resilience, and the injustice they endured.
		</p>

		<div class="memorial-grid">
			{memorialEntries.map(entry => (
				<div class="memorial-card">
					<h3 class="name">{entry.data.name}</h3>
					<div class="details">
						{entry.data.yearOfBirth && <p><strong>Born:</strong> ~{entry.data.yearOfBirth}</p>}
						{entry.data.origin && <p><strong>Origin:</strong> {entry.data.origin}</p>}
						{entry.data.location && <p><strong>Location:</strong> {entry.data.location}</p>}
					</div>
					{entry.data.notes && <p class="notes">{entry.data.notes}</p>}
				</div>
			))}
			
			{memorialEntries.length === 0 && (
				<p class="empty-state">The register is currently being compiled.</p>
			)}
		</div>
	</section>
</Layout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--space-lg);
		text-align: center;
	}
	
	.page-header h1 {
		font-size: clamp(2.5rem, 6vw, 5rem);
		color: var(--color-text);
	}
	
	.subtitle {
		font-size: 1.25rem;
		color: var(--color-text-muted);
		font-style: italic;
		font-family: var(--font-heading);
	}

	.intro-text {
		max-width: 800px;
		margin: 0 auto var(--space-xl);
		text-align: center;
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.memorial-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--space-md);
		padding-bottom: var(--space-xl);
	}

	.memorial-card {
		background-color: var(--color-bg-light);
		padding: var(--space-md);
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-accent);
		border-radius: 4px;
		transition: transform var(--transition-fast), box-shadow var(--transition-fast);
	}

	.memorial-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
		border-left-color: var(--color-accent-hover);
	}

	.name {
		font-size: 1.5rem;
		margin-bottom: var(--space-xs);
		color: var(--color-text);
	}

	.details {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		margin-bottom: var(--space-sm);
	}

	.details p {
		margin-bottom: 0.25rem;
	}
	
	.details strong {
		color: var(--color-text);
	}

	.notes {
		font-size: 0.95rem;
		line-height: 1.5;
		margin-bottom: 0;
		padding-top: var(--space-sm);
		border-top: 1px dashed var(--color-border);
	}
	
	.empty-state {
		text-align: center;
		color: var(--color-text-muted);
		font-style: italic;
		grid-column: 1 / -1;
	}
</style>
