---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = [
	{
		question: "What is the purpose of this digital memorial?",
		answer: "The Danish West Indies Memorial Register is a digital humanities project dedicated to restoring the identities and historical context of the enslaved individuals who lived, labored, and resisted in the Danish West Indies. It aims to make archival data accessible to researchers, students, and most importantly, descendants."
	},
	{
		question: "Where does the data come from?",
		answer: "The data is primarily sourced from the historical censuses, ledgers, and Moravian missionary diaries held in the Danish National Archives (Rigsarkivet). This raw archival data has been carefully transcribed and contextualized by historians."
	},
	{
		question: "Why are there so many languages available?",
		answer: "The transatlantic slave trade crossed numerous linguistic and colonial boundaries. By offering the memorial in 13 languages—including colonial languages (Danish, Dutch, French, Spanish), African languages (Akan, Yoruba, Igbo, Kikongo), and Creoles (Negerhollands)—we aim to remove barriers to accessibility and honor the diverse origins of the ancestors."
	},
	{
		question: "Can I contribute to the register?",
		answer: "Yes. If you are a descendant with family history, or a researcher with access to verified historical documents, you can contact us to help expand the memorial's records."
	},
	{
		question: "What was the Emancipation of 1848?",
		answer: "On July 3, 1848, enslaved workers on St. Croix, led by John Gottlieb (General Buddhoe), organized a mass rebellion, marching on Frederiksted and demanding their freedom. Governor-General Peter von Scholten, facing overwhelming numbers, declared emancipation, ending legal slavery in the Danish West Indies."
	},
	{
		question: "What was the Fireburn (1878)?",
		answer: "The Fireburn was a massive labor revolt in 1878 led by prominent women known as the \"Queens\" of the Fireburn (Queen Mary, Queen Agnes, and Queen Mathilda). Decades after emancipation, workers were still tied to estates by oppressive labor laws. They revolted, burning down estates across St. Croix to demand fair wages and better conditions."
	}
];
---

<Layout title="FAQ & Q&A | Danish West Indies">
	<div class="page-container animate-fade-in">
		<header class="page-header">
			<span class="label">Knowledge Base</span>
			<h1>FAQ & Q&A</h1>
			<p class="subtitle">Frequently asked questions regarding the project, the historical archives, and the history of the Danish West Indies.</p>
		</header>

		<div class="faq-container">
			{faqs.map((faq) => (
				<details class="faq-item">
					<summary class="faq-question">
						{faq.question}
						<span class="icon"></span>
					</summary>
					<div class="faq-answer">
						<p>{faq.answer}</p>
					</div>
				</details>
			))}
		</div>

		<div class="contact-prompt">
			<h2>Have a question not listed here?</h2>
			<a href="/contact" class="btn-primary">Contact Us</a>
		</div>
	</div>
</Layout>

<style>
	.page-container {
		max-width: 800px;
		margin: 0 auto;
		padding-bottom: var(--space-2xl);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--space-2xl);
	}

	.label {
		display: inline-block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--color-accent);
		background: rgba(196, 167, 125, 0.1);
		padding: 0.3rem 0.8rem;
		border-radius: 20px;
		margin-bottom: var(--space-sm);
	}

	.page-header h1 {
		color: var(--color-accent);
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 1.1rem;
		font-style: italic;
		line-height: 1.5;
	}

	.faq-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: var(--space-2xl);
	}

	.faq-item {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(196, 167, 125, 0.15);
		border-radius: 8px;
		overflow: hidden;
		transition: all 0.3s;
	}

	.faq-item[open] {
		background: rgba(196, 167, 125, 0.05);
		border-color: rgba(196, 167, 125, 0.4);
	}

	.faq-question {
		padding: 1.5rem;
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 500;
		color: var(--color-text);
		cursor: pointer;
		position: relative;
		list-style: none; /* Hide default triangle in some browsers */
		display: flex;
		justify-content: space-between;
		align-items: center;
		transition: color 0.3s;
	}

	.faq-question::-webkit-details-marker {
		display: none; /* Hide default triangle in WebKit */
	}

	.faq-question:hover {
		color: var(--color-accent);
	}

	.faq-question .icon {
		position: relative;
		width: 20px;
		height: 20px;
		flex-shrink: 0;
	}

	/* Plus icon */
	.faq-question .icon::before,
	.faq-question .icon::after {
		content: '';
		position: absolute;
		background-color: var(--color-accent);
		transition: transform 0.3s ease;
	}

	.faq-question .icon::before {
		top: 9px;
		left: 0;
		width: 100%;
		height: 2px;
	}

	.faq-question .icon::after {
		top: 0;
		left: 9px;
		width: 2px;
		height: 100%;
	}

	/* Turn to minus when open */
	.faq-item[open] .faq-question .icon::after {
		transform: rotate(90deg);
	}

	.faq-item[open] .faq-question {
		color: var(--color-accent);
		border-bottom: 1px solid rgba(196, 167, 125, 0.1);
	}

	.faq-answer {
		padding: 1.5rem;
		color: rgba(255, 255, 255, 0.85);
		line-height: 1.7;
		font-size: 1.05rem;
		animation: slideDown 0.3s ease-out;
	}

	.contact-prompt {
		text-align: center;
		margin-top: var(--space-2xl);
		padding-top: var(--space-xl);
		border-top: 1px dashed rgba(196, 167, 125, 0.2);
	}

	.contact-prompt h2 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
		color: var(--color-text);
	}

	.btn-primary {
		display: inline-block;
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-heading);
		font-weight: bold;
		padding: 0.8rem 2rem;
		border-radius: 4px;
		text-decoration: none;
		transition: all 0.3s;
	}

	.btn-primary:hover {
		background: #d4b88f;
		transform: translateY(-2px);
		box-shadow: 0 5px 15px rgba(196, 167, 125, 0.3);
	}

	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>
