---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Danish West Indies - Home">
	<section class="hero animate-fade-in">
		<div class="hero-content">
			<h1>A History of the <br/><span class="text-accent">Danish West Indies</span></h1>
			<p class="subtitle">Shedding light on the sins of the past and honoring those who were enslaved.</p>
			<div class="actions">
				<a href="/history" class="btn btn-primary">Learn the History</a>
				<a href="/thesis" class="btn btn-secondary">Read the Thesis</a>
			</div>
		</div>
	</section>

	<section class="mission-section animate-fade-in" style="animation-delay: 0.2s;">
		<h2>Our Mission</h2>
		<p>
			This website serves as a public resource dedicated to the history of the Danish West Indies (1672–1917).
			It is built to gather information, offer educational materials, and most importantly, to honor the enslaved individuals who suffered under inhumane conditions.
		</p>
		<p>
			Through comprehensive historical accounts, resources, and our ongoing Master's thesis in Economic History from the University of Copenhagen, we aim to uncover truths that must not be forgotten.
		</p>
	</section>
</Layout>

<style>
	.hero {
		min-height: 70vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--space-xl);
	}
	
	.hero-content {
		max-width: 800px;
	}
	
	.subtitle {
		font-size: 1.5rem;
		color: var(--color-text-muted);
		margin-bottom: var(--space-lg);
		max-width: 600px;
	}
	
	.actions {
		display: flex;
		gap: var(--space-md);
	}
	
	.btn {
		display: inline-block;
		padding: 0.8rem 1.5rem;
		border-radius: 4px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-size: 0.9rem;
		transition: all var(--transition-fast);
	}
	
	.btn-primary {
		background-color: var(--color-accent);
		color: var(--color-bg);
	}
	
	.btn-primary:hover {
		background-color: var(--color-accent-hover);
		color: var(--color-bg);
	}
	
	.btn-secondary {
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
	}
	
	.btn-secondary:hover {
		background-color: rgba(196, 167, 125, 0.1);
	}
	
	.mission-section {
		max-width: 800px;
		margin: 0 auto;
		padding-bottom: var(--space-xl);
	}
</style>
