---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const historyDocs = await getCollection('history');
const thesisDocs = await getCollection('thesis');
---

<Layout title="For Educators | Danish West Indies Research Portal">
	<div class="page-container animate-fade-in">
		
		<!-- HERO SECTION -->
		<header class="educator-hero no-print">
			<div class="hero-content">
				<span class="label">Academic Resources</span>
				<h1>For Educators & Syllabi</h1>
				<p class="lead">Bring rigorous economic history into your classroom. This portal packages the primary research, data analysis, and historical narratives of our Master's thesis into ready-to-use thematic modules for university and advanced high school courses.</p>
				<div class="hero-actions">
					<button class="btn-primary" onclick="window.print()">🖨️ Download Syllabus (PDF)</button>
					<a href="#modules" class="btn-secondary">View Modules ↓</a>
				</div>
			</div>
			<div class="hero-graphics">
				<div class="academic-badge">🎓</div>
				<ul class="curriculum-tags">
					<li>Caribbean Studies</li>
					<li>Economic History</li>
					<li>European Colonialism</li>
					<li>Data Analysis</li>
				</ul>
			</div>
		</header>

		<!-- PRINT HEADER (Only visible on PDF export) -->
		<div class="print-header only-print">
			<h1>Danish West Indies: A History of Economics and Resistance</h1>
			<h2>Suggested Curriculum & Reading Guide</h2>
			<p>Source: <strong>danishwestindies.org</strong> | Based on the Master's Thesis by J.A.S. Nielsen & S.Y.M. Chen.</p>
			<hr />
		</div>

		<!-- MODULES SECTION -->
		<section id="modules" class="modules-section">
			<h2 class="section-title">Thematic Teaching Modules</h2>
			
			<!-- MODULE 1 -->
			<div class="module-card">
				<div class="module-header">
					<span class="module-number">Module 01</span>
					<h3>The Economics of Empire</h3>
					<p class="module-theme">Focuses on the transatlantic structure, corporate monopolies, and the sheer scale of the plantation economy.</p>
				</div>
				<div class="module-body">
					<div class="module-col">
						<h4>Required Readings</h4>
						<ul class="reading-list">
							<li><a href="/history/west-india-company-monopoly">The Monopoly of the West India Company</a></li>
							<li><a href="/history/the-colonial-ledger">The Colonial Ledger (Anatomy of an Estate)</a></li>
							<li><a href="/history/schimmelmann-family">The Schimmelmann Family: Wealth & Power</a></li>
						</ul>
					</div>
					<div class="module-col">
						<h4>Interactive Data</h4>
						<ul class="data-list">
							<li><a href="/thesis/data">Explore: Sugar Production vs. Labor Force Charts</a></li>
							<li><a href="/thesis/interactive-maps">GIS Map: The Major Sugar Estates of St. Croix</a></li>
						</ul>
					</div>
				</div>
				<div class="module-discussion">
					<h4>Discussion Prompt</h4>
					<p>How did the corporate structure of the Danish West India and Guinea Company distance European shareholders from the brutal realities of plantation labor? Discuss the ethical implications of joint-stock colonialism.</p>
				</div>
			</div>

			<!-- MODULE 2 -->
			<div class="module-card">
				<div class="module-header">
					<span class="module-number">Module 02</span>
					<h3>The Architecture of Control</h3>
					<p class="module-theme">Analyzes the legal frameworks, military infrastructure, and social hierarchies designed to maximize economic output.</p>
				</div>
				<div class="module-body">
					<div class="module-col">
						<h4>Required Readings</h4>
						<ul class="reading-list">
							<li><a href="/history/1733-slave-codes">The 1733 Slave Codes (Legal Dehumanization)</a></li>
							<li><a href="/history/free-people-of-color">The In-Between Class: Free People of Color</a></li>
						</ul>
					</div>
					<div class="module-col">
						<h4>Interactive Data</h4>
						<ul class="data-list">
							<li><a href="/thesis/interactive-maps">GIS Map: The Infrastructure of Danish Forts</a></li>
						</ul>
					</div>
				</div>
				<div class="module-discussion">
					<h4>Discussion Prompt</h4>
					<p>Analyze Governor Philip Gardelin's 1733 Slave Codes. In what ways did the colonial legal system serve primarily as a tool for protecting economic capital (enslaved labor and property) rather than a moral or social framework?</p>
				</div>
			</div>

			<!-- MODULE 3 -->
			<div class="module-card">
				<div class="module-header">
					<span class="module-number">Module 03</span>
					<h3>Resistance, Rebellion, and Emancipation</h3>
					<p class="module-theme">Examines how the enslaved population actively disrupted the colonial economy, forcing the eventual collapse of the system.</p>
				</div>
				<div class="module-body">
					<div class="module-col">
						<h4>Required Readings</h4>
						<ul class="reading-list">
							<li><a href="/history/1733-st-john-rebellion">The 1733 Akwamu Rebellion (St. John)</a></li>
							<li><a href="/history/1848-emancipation">1848: The Threat of Violence and Emancipation</a></li>
							<li><a href="/history/mary-thomas">Queen Mary Thomas & The 1878 Fireburn</a></li>
						</ul>
					</div>
					<div class="module-col">
						<h4>Interactive Data</h4>
						<ul class="data-list">
							<li><a href="/thesis/interactive-maps">GIS Map: Tracing the Route of the 1878 Fireburn</a></li>
						</ul>
					</div>
				</div>
				<div class="module-discussion">
					<h4>Discussion Prompt</h4>
					<p>Emancipation in 1848 did not end economic exploitation, culminating in the 1878 Fireburn. Discuss the economic factors (like the 1849 Labor Act) that drove laborers to riot three decades *after* legal freedom was achieved.</p>
				</div>
			</div>
		</section>

		<!-- INTERACTIVE TOOLS SECTION -->
		<section class="interactive-tools-section no-print">
			<h2 class="section-title">Interactive Classroom Tools</h2>
			
			<div class="ai-generator-panel">
				<h3>✨ AI Dynamic Lesson Generator</h3>
				<p>Select any historical article or thesis chapter below. Our AI will read the text and instantly generate custom flashcards and a knowledge check quiz based on its contents!</p>
				<div class="generator-controls">
					<select id="lesson-source-select" class="lesson-select">
						<optgroup label="History Articles">
							{historyDocs.map(doc => (
								<option value={`history|${doc.id}`}>{doc.data.title}</option>
							))}
						</optgroup>
						<optgroup label="Master's Thesis">
							{thesisDocs.map(doc => (
								<option value={`thesis|${doc.id}`}>{doc.data.title}</option>
							))}
						</optgroup>
					</select>
					<button id="btn-generate-lesson" class="btn-generate">✨ Generate Resources</button>
				</div>
				<div id="generator-status" class="generator-status hidden"></div>
			</div>

			<div class="tools-grid">
				<!-- Flashcards -->
				<div class="tool-card flashcards-container">
					<h3>Historical Glossary Flashcards</h3>
					<p>Test your knowledge of key terminology from the Danish West Indies.</p>
					
					<div class="flashcard-deck">
						<div class="flashcard" id="flashcard">
							<div class="flashcard-inner" id="flashcard-inner">
								<div class="flashcard-front">
									<span class="card-hint">Click to flip</span>
									<h4 id="fc-term">Middle Passage</h4>
								</div>
								<div class="flashcard-back">
									<p id="fc-def">The horrific transatlantic journey of enslaved Africans from the West African coast to the Americas.</p>
								</div>
							</div>
						</div>
						<div class="flashcard-controls">
							<button id="fc-prev" class="btn-tool">← Previous</button>
							<span id="fc-counter" class="card-counter">1 / 6</span>
							<button id="fc-next" class="btn-tool">Next →</button>
						</div>
					</div>
				</div>

				<!-- Quiz -->
				<div class="tool-card quiz-container">
					<h3>Knowledge Check</h3>
					<p>Quick assessment on key events and dates.</p>
					
					<div class="quiz-box" id="quiz-box">
						<h4 id="quiz-question">Loading...</h4>
						<div class="quiz-options" id="quiz-options">
							<!-- Populated by JS -->
						</div>
						<div id="quiz-feedback" class="quiz-feedback hidden"></div>
						<div class="quiz-controls">
							<button id="quiz-next" class="btn-tool hidden">Next Question →</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ESSAY TOPICS SECTION -->
		<section class="essays-section">
			<h2 class="section-title">Suggested Essay Topics</h2>
			<div class="essay-grid">
				<div class="essay-card">
					<div class="essay-icon">⚖️</div>
					<h3>The Price of Emancipation</h3>
					<p>When the transatlantic slave trade was officially abolished in 1792 (taking effect in 1803), the Danish Crown offered state-backed loans to planters to purchase as many enslaved people as possible before the deadline. Analyze the economic rationale behind this policy and its demographic impact on the islands.</p>
				</div>
				<div class="essay-card">
					<div class="essay-icon">📈</div>
					<h3>Data and Dehumanization</h3>
					<p>Utilizing the data presented in *The Colonial Ledger*, write an econometric analysis of a typical St. Croix sugar estate in the 1780s. How did the meticulous bookkeeping of mortality, birth rates, and sugar output reflect the commodification of human life?</p>
				</div>
				<div class="essay-card">
					<div class="essay-icon">🔥</div>
					<h3>The Economics of the Fireburn</h3>
					<p>Compare and contrast the economic motivations of the 1733 St. John Rebellion (led by enslaved Akwamu) and the 1878 Fireburn (led by legally free laborers like Mary Thomas). How did the shift from a slave economy to a contracted-wage economy alter the nature of resistance?</p>
				</div>
				<div class="essay-card">
					<div class="essay-icon">🌍</div>
					<h3>The Metropole and the Periphery</h3>
					<p>Trace the flow of wealth from the plantations of the Danish West Indies to the palaces of Copenhagen (focusing on families like the Schimmelmanns). How did colonial extraction fund the "Golden Age" of Danish culture and architecture?</p>
				</div>
			</div>
		</section>

	</div>
</Layout>

<style>
	.page-container { max-width: 1200px; margin: 0 auto; padding-bottom: var(--space-3xl); }
	
	/* HERO SECTION */
	.educator-hero {
		display: grid; grid-template-columns: 1.5fr 1fr; gap: 4rem; align-items: center;
		background: linear-gradient(135deg, rgba(30,30,30,0.8) 0%, rgba(15,15,15,0.9) 100%);
		border: 1px solid rgba(196, 167, 125, 0.3); border-radius: 12px;
		padding: 4rem; margin-bottom: 4rem; box-shadow: 0 20px 40px rgba(0,0,0,0.4);
	}
	.label {
		display: inline-block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px;
		color: var(--color-bg); background: var(--color-accent); padding: 0.4rem 1rem;
		border-radius: 20px; margin-bottom: 1rem; font-weight: bold;
	}
	.hero-content h1 { font-family: var(--font-heading); font-size: 3.5rem; color: var(--color-text); margin-bottom: 1.5rem; line-height: 1.1; }
	.hero-content .lead { font-size: 1.2rem; color: rgba(255, 255, 255, 0.85); line-height: 1.8; margin-bottom: 2rem; }
	
	.hero-actions { display: flex; gap: 1rem; }
	.btn-primary { background: var(--color-accent); color: var(--color-bg); border: none; padding: 0.8rem 1.5rem; border-radius: 6px; font-weight: bold; font-size: 1rem; cursor: pointer; transition: transform 0.2s, background 0.2s; }
	.btn-primary:hover { transform: translateY(-2px); background: #d6b88a; }
	.btn-secondary { background: transparent; color: var(--color-accent); border: 1px solid var(--color-accent); padding: 0.8rem 1.5rem; border-radius: 6px; font-weight: bold; font-size: 1rem; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; }
	.btn-secondary:hover { background: rgba(196, 167, 125, 0.1); }

	.hero-graphics { display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(0,0,0,0.2); padding: 3rem; border-radius: 50%; aspect-ratio: 1; border: 1px dashed rgba(196,167,125,0.4); }
	.academic-badge { font-size: 5rem; margin-bottom: 1.5rem; }
	.curriculum-tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }
	.curriculum-tags li { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.4rem 0.8rem; border-radius: 20px; font-size: 0.85rem; color: var(--color-text-muted); }

	.section-title { font-family: var(--font-heading); font-size: 2.5rem; color: var(--color-text); margin-bottom: 2.5rem; text-align: center; }

	/* MODULES */
	.modules-section { margin-bottom: 5rem; }
	.module-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; margin-bottom: 2rem; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transition: transform 0.3s ease; }
	.module-card:hover { transform: translateY(-5px); border-color: rgba(196, 167, 125, 0.4); }
	
	.module-header { background: rgba(196, 167, 125, 0.05); padding: 2rem; border-bottom: 1px solid var(--color-border); }
	.module-number { font-family: monospace; font-size: 0.9rem; color: var(--color-accent); letter-spacing: 2px; display: block; margin-bottom: 0.5rem; }
	.module-header h3 { font-family: var(--font-heading); font-size: 2rem; color: var(--color-text); margin: 0 0 0.5rem 0; }
	.module-theme { color: var(--color-text-muted); font-size: 1.1rem; margin: 0; font-style: italic; }

	.module-body { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding: 2rem; }
	.module-col h4 { font-size: 1rem; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.5); margin-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem; }
	.reading-list, .data-list { list-style: none; padding: 0; margin: 0; }
	.reading-list li, .data-list li { margin-bottom: 0.8rem; padding-left: 1.5rem; position: relative; }
	.reading-list li::before { content: "📄"; position: absolute; left: 0; top: 2px; font-size: 0.9rem; }
	.data-list li::before { content: "📊"; position: absolute; left: 0; top: 2px; font-size: 0.9rem; }
	.reading-list a, .data-list a { color: var(--color-text); text-decoration: none; font-size: 1.05rem; transition: color 0.2s; }
	.reading-list a:hover, .data-list a:hover { color: var(--color-accent); text-decoration: underline; }

	.module-discussion { background: rgba(0,0,0,0.3); padding: 1.5rem 2rem; border-top: 1px solid var(--color-border); }
	.module-discussion h4 { color: var(--color-accent); margin: 0 0 0.5rem 0; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem; }
	.module-discussion h4::before { content: "💬"; }
	.module-discussion p { color: rgba(255,255,255,0.9); margin: 0; line-height: 1.6; font-size: 1.05rem; }

	/* INTERACTIVE TOOLS */
	.interactive-tools-section { margin-bottom: 5rem; }
	.tools-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
	.tool-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
	.tool-card h3 { font-family: var(--font-heading); color: var(--color-accent); font-size: 1.5rem; margin-bottom: 0.5rem; }
	.tool-card p { color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 2rem; }
	
	.btn-tool { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: var(--color-text); padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; transition: all 0.2s; font-size: 0.9rem; }
	.btn-tool:hover { background: rgba(196,167,125,0.1); border-color: var(--color-accent); color: var(--color-accent); }
	.hidden { display: none !important; }

	/* AI Generator Panel */
	.ai-generator-panel { background: rgba(196,167,125,0.05); border: 1px solid rgba(196,167,125,0.3); border-radius: 12px; padding: 2rem; margin-bottom: 2rem; text-align: center; }
	.ai-generator-panel h3 { color: var(--color-accent); font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 0.5rem; }
	.ai-generator-panel p { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 1.05rem; }
	.generator-controls { display: flex; gap: 1rem; justify-content: center; max-width: 600px; margin: 0 auto; }
	.lesson-select { flex-grow: 1; padding: 0.8rem; border-radius: 6px; border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text); font-size: 1rem; }
	.btn-generate { background: linear-gradient(135deg, rgba(196,167,125,0.2), rgba(196,167,125,0.05)); border: 1px solid rgba(196,167,125,0.4); color: var(--color-accent); padding: 0.8rem 1.5rem; border-radius: 6px; font-weight: bold; cursor: pointer; transition: all 0.2s; }
	.btn-generate:hover { transform: translateY(-2px); background: rgba(196,167,125,0.3); }
	.btn-generate:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
	.generator-status { margin-top: 1rem; color: var(--color-accent); font-style: italic; }

	/* Flashcards */
	.flashcard-deck { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
	.flashcard { width: 100%; height: 200px; perspective: 1000px; cursor: pointer; }
	.flashcard-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.6s; transform-style: preserve-3d; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
	.flashcard.flipped .flashcard-inner { transform: rotateY(180deg); }
	.flashcard-front, .flashcard-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 2rem; border: 1px solid rgba(196,167,125,0.3); }
	.flashcard-front { background: linear-gradient(135deg, rgba(30,30,30,0.9), rgba(15,15,15,0.9)); color: var(--color-text); }
	.flashcard-back { background: rgba(196,167,125,0.1); color: var(--color-text); transform: rotateY(180deg); }
	.card-hint { position: absolute; top: 10px; font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 1px; }
	.flashcard-front h4 { font-family: var(--font-heading); font-size: 1.8rem; margin: 0; color: var(--color-accent); }
	.flashcard-back p { font-size: 1.1rem; line-height: 1.6; margin: 0; color: rgba(255,255,255,0.9); }
	.flashcard-controls { display: flex; align-items: center; gap: 1rem; }
	.card-counter { font-family: monospace; color: var(--color-text-muted); }

	/* Quiz */
	.quiz-box { background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 1.5rem; }
	.quiz-box h4 { font-size: 1.15rem; color: var(--color-text); margin-bottom: 1.5rem; line-height: 1.4; }
	.quiz-options { display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 1.5rem; }
	.quiz-option { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); color: var(--color-text); padding: 1rem; border-radius: 6px; cursor: pointer; text-align: left; font-size: 1rem; transition: all 0.2s; }
	.quiz-option:hover { background: rgba(255,255,255,0.08); }
	.quiz-option.correct { background: rgba(34, 197, 94, 0.2); border-color: #22c55e; }
	.quiz-option.wrong { background: rgba(239, 68, 68, 0.2); border-color: #ef4444; }
	.quiz-feedback { padding: 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.95rem; line-height: 1.5; }
	.quiz-feedback.success { background: rgba(34, 197, 94, 0.1); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.2); }
	.quiz-feedback.error { background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); }
	.quiz-controls { display: flex; justify-content: flex-end; }

	/* ESSAYS */
	.essay-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
	.essay-card { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 2rem; border-radius: 12px; transition: background 0.3s; }
	.essay-card:hover { background: rgba(255,255,255,0.05); border-color: rgba(196, 167, 125, 0.2); }
	.essay-icon { font-size: 2.5rem; margin-bottom: 1rem; }
	.essay-card h3 { font-family: var(--font-heading); color: var(--color-text); margin-bottom: 1rem; font-size: 1.3rem; }
	.essay-card p { color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6; margin: 0; }

	/* PRINT CSS */
	.only-print { display: none; }
	
	@media print {
		body { background: white !important; color: black !important; font-family: "Times New Roman", Times, serif; }
		.no-print, nav, footer, .hero-graphics, .btn-primary, .btn-secondary { display: none !important; }
		.only-print { display: block; margin-bottom: 2rem; }
		.page-container { max-width: 100%; padding: 0; }
		.print-header h1 { font-size: 24pt; margin-bottom: 0.5rem; }
		.print-header h2 { font-size: 16pt; font-style: italic; color: #444; }
		.section-title { font-size: 20pt; text-align: left; border-bottom: 2px solid black; padding-bottom: 0.5rem; }
		
		.module-card { border: none; box-shadow: none; border-bottom: 1px dashed #ccc; padding-bottom: 2rem; margin-bottom: 2rem; page-break-inside: avoid; }
		.module-header { background: none; padding: 0 0 1rem 0; border: none; }
		.module-header h3 { font-size: 16pt; color: black; }
		.module-number { color: black; font-weight: bold; }
		.module-theme { color: #333; }
		
		.module-body { grid-template-columns: 1fr; gap: 1rem; padding: 0; margin-bottom: 1rem; }
		.reading-list a, .data-list a { color: black !important; text-decoration: underline; }
		.module-discussion { background: #f9f9f9; border: 1px solid #ddd; padding: 1rem; page-break-inside: avoid; }
		.module-discussion h4 { color: black; }
		.module-discussion p { color: black; }

		.essay-grid { grid-template-columns: 1fr; gap: 1.5rem; }
		.essay-card { border: none; padding: 0; margin-bottom: 1.5rem; page-break-inside: avoid; }
		.essay-card h3 { font-size: 14pt; margin-bottom: 0.5rem; }
		.essay-card p { color: black; }
		.essay-icon { display: none; }
	}

	@media (max-width: 900px) {
		.educator-hero { grid-template-columns: 1fr; padding: 2rem; gap: 2rem; text-align: center; }
		.hero-actions { justify-content: center; }
		.hero-graphics { display: none; }
		.module-body { grid-template-columns: 1fr; }
		.tools-grid { grid-template-columns: 1fr; }
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// --- FLASHCARDS LOGIC ---
		const glossary = [
			{ term: "Middle Passage", def: "The horrific transatlantic journey of enslaved Africans from the West African coast to the Americas." },
			{ term: "Chattel Slavery", def: "A form of slavery where humans are treated as personal property to be bought, sold, and inherited." },
			{ term: "Rix-dollar", def: "The official currency used in the Danish West Indies (Rigsdaler)." },
			{ term: "Marronage", def: "The act of enslaved people escaping and forming independent settlements (Maroons)." },
			{ term: "Bamboula", def: "A traditional drum dance originating from enslaved Africans in the Virgin Islands, often used for communication and resistance." },
			{ term: "Fireburn", def: "The massive 1878 labor riot on St. Croix where workers demanded better wages and working conditions." }
		];

		let currentCard = 0;
		const flashcard = document.getElementById('flashcard');
		const termEl = document.getElementById('fc-term');
		const defEl = document.getElementById('fc-def');
		const counterEl = document.getElementById('fc-counter');
		
		function updateCard() {
			flashcard.classList.remove('flipped');
			setTimeout(() => {
				termEl.textContent = glossary[currentCard].term;
				defEl.textContent = glossary[currentCard].def;
				counterEl.textContent = `${currentCard + 1} / ${glossary.length}`;
			}, 150);
		}

		flashcard?.addEventListener('click', () => flashcard.classList.toggle('flipped'));
		document.getElementById('fc-prev')?.addEventListener('click', () => {
			currentCard = (currentCard - 1 + glossary.length) % glossary.length;
			updateCard();
		});
		document.getElementById('fc-next')?.addEventListener('click', () => {
			currentCard = (currentCard + 1) % glossary.length;
			updateCard();
		});
		updateCard();

		// --- QUIZ LOGIC ---
		const questions = [
			{
				q: "When did Denmark formally issue the decree to abolish the transatlantic slave trade?",
				opts: ["1733", "1792", "1803", "1848"],
				ans: 1,
				expl: "The decree was issued in 1792, though it intentionally included a 10-year transition period and didn't take effect until 1803."
			},
			{
				q: "Which event directly caused the final emancipation of enslaved people in the Danish West Indies?",
				opts: ["The 1733 St. John Rebellion", "The 1878 Fireburn", "The 1848 Emancipation Rebellion led by General Buddhoe", "A royal decree by the King of Denmark"],
				ans: 2,
				expl: "In 1848, thousands of enslaved people marched on Fort Frederik, forcing Governor Peter von Scholten to declare immediate emancipation to avoid a massacre."
			},
			{
				q: "What was the primary purpose of the 1733 Slave Codes?",
				opts: ["To provide basic human rights to laborers", "To organize the first labor union", "To protect economic capital through brutal legal oppression and punishment", "To establish a free press"],
				ans: 2,
				expl: "The 1733 codes were a horrific set of laws designed solely to punish resistance and protect the planters' economic investments in human property."
			}
		];

		let currentQ = 0;
		const qEl = document.getElementById('quiz-question');
		const optsEl = document.getElementById('quiz-options');
		const feedbackEl = document.getElementById('quiz-feedback');
		const nextBtn = document.getElementById('quiz-next');

		function loadQuestion() {
			if (!qEl) return;
			const q = questions[currentQ];
			qEl.textContent = q.question || q.q; // support both keys
			optsEl.innerHTML = '';
			feedbackEl.classList.add('hidden');
			nextBtn.classList.add('hidden');

			const options = q.options || q.opts;
			const ansIdx = q.answerIndex !== undefined ? q.answerIndex : q.ans;

			options.forEach((opt, idx) => {
				const btn = document.createElement('button');
				btn.className = 'quiz-option';
				btn.textContent = opt;
				btn.addEventListener('click', () => handleAnswer(idx, btn, ansIdx, q.explanation || q.expl));
				optsEl.appendChild(btn);
			});
		}

		function handleAnswer(idx, btn, correctIdx, expl) {
			const allBtns = optsEl.querySelectorAll('.quiz-option');
			allBtns.forEach(b => b.style.pointerEvents = 'none'); // Disable clicks

			if (idx === correctIdx) {
				btn.classList.add('correct');
				feedbackEl.textContent = `Correct! ${expl}`;
				feedbackEl.className = 'quiz-feedback success';
			} else {
				btn.classList.add('wrong');
				allBtns[correctIdx].classList.add('correct');
				feedbackEl.textContent = `Incorrect. ${expl}`;
				feedbackEl.className = 'quiz-feedback error';
			}
			
			nextBtn.classList.remove('hidden');
			if (currentQ === questions.length - 1) {
				nextBtn.textContent = "Restart Quiz";
			} else {
				nextBtn.textContent = "Next Question →";
			}
		}

		nextBtn?.addEventListener('click', () => {
			currentQ = (currentQ + 1) % questions.length;
			loadQuestion();
		});

		loadQuestion();

		// --- AI GENERATOR LOGIC ---
		const btnGenerate = document.getElementById('btn-generate-lesson');
		const selectSource = document.getElementById('lesson-source-select');
		const statusEl = document.getElementById('generator-status');

		if (btnGenerate && selectSource && statusEl) {
			btnGenerate.addEventListener('click', async () => {
				const val = selectSource.value;
				if (!val) return;
				const [type, slug] = val.split('|');
				
				btnGenerate.disabled = true;
				btnGenerate.innerHTML = '✨ Generating...';
				statusEl.classList.remove('hidden');
				statusEl.innerHTML = '<span class="loading-pulse">Analyzing text and generating lesson plan...</span>';

				try {
					const response = await fetch('/api/generate-lesson', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ type, slug })
					});

					if (!response.ok) throw new Error('Failed to generate lesson');
					
					const data = await response.json();
					
					// Update Flashcards
					if (data.flashcards && Array.isArray(data.flashcards)) {
						glossary.length = 0; // Clear array
						data.flashcards.forEach(fc => glossary.push({ term: fc.term, def: fc.definition || fc.def }));
						currentCard = 0;
						updateCard();
					}

					// Update Quiz
					if (data.quiz && Array.isArray(data.quiz)) {
						questions.length = 0;
						data.quiz.forEach(q => questions.push(q));
						currentQ = 0;
						loadQuestion();
					}

					statusEl.innerHTML = '✨ Lesson successfully generated!';
					setTimeout(() => statusEl.classList.add('hidden'), 3000);
				} catch (err) {
					console.error(err);
					statusEl.innerHTML = '<span style="color:#ef4444;">Error generating lesson plan. Please try again.</span>';
				} finally {
					btnGenerate.disabled = false;
					btnGenerate.innerHTML = '✨ Generate Resources';
				}
			});
		}
	});
</script>
