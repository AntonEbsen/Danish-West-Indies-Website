---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { 
	title = "Danish West Indies - Research Portal",
	description = "Explore the Danish West Indies research portal, a comprehensive collection of historical records, thesis works, and interactive exhibits.",
	image = "/favicon.svg" // Fallback to favicon if no other image is provided
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);

// Hreflang logic for 13 locales
const locales = ["en", "da", "es", "fr", "nl", "ak", "de", "nh", "yo", "ig", "kg", "sv", "pt"];
let basePath = Astro.url.pathname;
if (lang !== "en" && basePath.startsWith(`/${lang}`)) {
	basePath = basePath.replace(`/${lang}`, '') || '/';
}
// Breadcrumb Schema Logic
const pathParts = canonicalURL.pathname.split('/').filter(p => p !== '' && !locales.includes(p));
const breadcrumbItems = pathParts.map((part, index) => {
	const prefix = lang === "en" ? "" : `/${lang}`;
	const pathSegment = pathParts.slice(0, index + 1).join('/');
	const url = new URL(`${prefix}/${pathSegment}`, Astro.site || Astro.url.origin).href;
	return {
		"@type": "ListItem",
		"position": index + 2,
		"name": part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
		"item": url
	};
});

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": new URL(lang === "en" ? "/" : `/${lang}`, Astro.site || Astro.url.origin).href
		},
		...breadcrumbItems
	]
};
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; script-src 'self' 'unsafe-inline';" />
		
		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Advanced SEO & Browser Tags -->
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#111111" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Multi-language hreflang tags -->
		{locales.map(l => {
			// Construct the localized path. 'en' is default (no prefix).
			const localizedPath = l === "en" ? basePath : `/${l}${basePath === '/' ? '' : basePath}`;
			const href = new URL(localizedPath, Astro.site || Astro.url.origin).href;
			return <link rel="alternate" hreflang={l} href={href} />;
		})}
		<link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site || Astro.url.origin).href} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site || Astro.url)} />
		<meta property="og:locale" content={lang} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.site || Astro.url)} />

		<!-- JSON-LD Schema -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Danish West Indies - Research Portal",
			"url": Astro.site?.toString() || Astro.url.origin,
			"description": "Explore the comprehensive history of the Danish West Indies (1672-1917).",
			"inLanguage": lang
		})} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<Header />
		<main class="container">
			<slot />
		</main>
		<Footer />
		
		<!-- GLOBAL IMAGE LIGHTBOX -->
		<div id="global-lightbox" class="lightbox-overlay hidden">
			<button id="lightbox-close" aria-label="Close image">✕</button>
			<img id="lightbox-img" src="" alt="Enlarged view" />
		</div>
	</body>
</html>

<style>
	/* Lightbox Styles */
	.lightbox-overlay {
		position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
		background: rgba(0,0,0,0.9); z-index: 10000;
		display: flex; justify-content: center; align-items: center;
		opacity: 1; transition: opacity 0.3s ease;
	}
	.lightbox-overlay.hidden {
		opacity: 0; pointer-events: none;
	}
	#lightbox-img {
		max-width: 90vw; max-height: 90vh;
		object-fit: contain; border-radius: 4px;
		box-shadow: 0 0 30px rgba(0,0,0,0.8);
		transform: scale(1); transition: transform 0.3s ease;
	}
	.lightbox-overlay.hidden #lightbox-img {
		transform: scale(0.95);
	}
	#lightbox-close {
		position: absolute; top: 20px; right: 30px;
		background: none; border: none; color: white;
		font-size: 2rem; cursor: pointer; opacity: 0.7;
		transition: opacity 0.2s;
	}
	#lightbox-close:hover { opacity: 1; color: var(--color-accent); }
	
	/* Apply zoom cursor to images inside content areas */
	:global(.article-content img), :global(.thesis-content img) {
		cursor: zoom-in;
		transition: filter 0.2s, transform 0.2s;
	}
	:global(.article-content img:hover), :global(.thesis-content img:hover) {
		filter: brightness(1.1);
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const lightbox = document.getElementById('global-lightbox');
		const lightboxImg = document.getElementById('lightbox-img');
		const closeBtn = document.getElementById('lightbox-close');
		if (!lightbox || !lightboxImg || !closeBtn) return;

		// Find all content images
		const images = document.querySelectorAll('.article-content img, .thesis-content img');
		
		images.forEach(img => {
			img.addEventListener('click', (e) => {
				// Don't open if it's already in a link that does something else
				if (img.closest('a') && img.closest('a').getAttribute('href') !== img.src) return;
				
				e.preventDefault();
				lightboxImg.src = img.src;
				lightboxImg.alt = img.alt;
				lightbox.classList.remove('hidden');
				document.body.style.overflow = 'hidden'; // Prevent background scrolling
			});
		});

		function closeLightbox() {
			lightbox.classList.add('hidden');
			document.body.style.overflow = '';
			setTimeout(() => { lightboxImg.src = ''; }, 300); // Clear after fade out
		}

		closeBtn.addEventListener('click', closeLightbox);
		lightbox.addEventListener('click', (e) => {
			if (e.target === lightbox) closeLightbox();
		});
		
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
				closeLightbox();
			}
		});
	});
</script>
